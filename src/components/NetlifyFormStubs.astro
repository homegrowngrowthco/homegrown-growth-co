---
// Static-rendered hidden form so Netlify's build-time HTML parser
// detects sms-opt-in as a form, even if the rendered SmsOptInForm
// elsewhere loses the data-netlify attribute. The real form submits
// via AJAX; this stub never renders visibly to users.
//
// Reference: https://docs.netlify.com/forms/setup/#html-forms
---
<form name="sms-opt-in" data-netlify="true" netlify-honeypot="bot-field" hidden aria-hidden="true">
  <input type="text" name="name" />
  <input type="email" name="email" />
  <input type="tel" name="phone" />
  <input type="checkbox" name="consent" />
  <input type="hidden" name="bot-field" />
</form>
