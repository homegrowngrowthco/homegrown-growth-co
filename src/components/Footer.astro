---
// Global footer, used on every page that uses BaseLayout.
// (roi-call previously had a minimal footer — under Astro that page
// can opt out of BaseLayout's footer via a prop if needed.)
---
<footer class="footer" role="contentinfo">
  <div class="container">
    <div class="footer__grid">
      <div>
        <a href="/" class="footer__logo">
          <span class="logo-mark"><span class="hg">HG</span><span class="c">C</span></span>
          <span class="logo-name">Homegrown Growth Co.</span>
        </a>
        <p class="footer__descriptor">Growth operations, owned end-to-end.</p>
      </div>
      <div>
        <p class="footer__col-title">Services</p>
        <nav class="footer__links" aria-label="Services links">
          <a href="/website-seo-geo" class="footer__link">Website SEO &amp; GEO</a>
          <a href="/demand-generation" class="footer__link">Demand Generation</a>
          <a href="/conversion-landing-pages" class="footer__link">Conversion &amp; Landing Pages</a>
          <a href="/gtm-strategy" class="footer__link">GTM Strategy</a>
          <a href="/crm-implementation" class="footer__link">CRM Implementation</a>
          <a href="/retention-expansion" class="footer__link">Retention &amp; Expansion</a>
          <a href="/reporting-analytics" class="footer__link">Reporting &amp; Analytics</a>
          <a href="/sales-comp-enablement" class="footer__link">Sales Comp &amp; Enablement</a>
          <a href="/process-automation" class="footer__link">Workflows &amp; Automation</a>
          <a href="/data-enrichment-hygiene" class="footer__link">Data Enrichment &amp; Hygiene</a>
          <a href="/fractional-revops" class="footer__link">Fractional RevOps</a>
          <a href="/tech-stack-audit" class="footer__link">Tech Stack Audit</a>
        </nav>
      </div>
      <div>
        <p class="footer__col-title">Industries</p>
        <nav class="footer__links" aria-label="Industries links">
          <a href="/for-saas" class="footer__link">For SaaS Teams</a>
          <a href="/for-local-businesses" class="footer__link">For Local &amp; Multi-Location</a>
        </nav>
        <p class="footer__col-title" style="margin-top:24px;">Company</p>
        <nav class="footer__links" aria-label="Company links">
          <a href="/case-studies" class="footer__link">Case Studies</a>
          <a href="/pricing" class="footer__link">Pricing</a>
          <a href="/about" class="footer__link">About</a>
          <a class="footer__link" data-obf-email data-eu="ian" data-ed="homegrowngrowth.co">Contact</a>
          <a href="https://www.linkedin.com/company/homegrown-growth-co" class="footer__link" target="_blank" rel="noopener">LinkedIn</a>
          <a href="/sms-opt-in" class="footer__link">SMS Updates</a>
          <a href="/privacy-policy" class="footer__link">Privacy Policy</a>
          <a href="/terms" class="footer__link">Terms &amp; Conditions</a>
        </nav>
      </div>
      <div>
        <p class="footer__col-title">Book a Call</p>
        <p class="footer__descriptor" style="margin-bottom:20px;">Thirty focused minutes. We diagnose where revenue is leaking, what's possible if it's rebuilt, and whether there's a fit.</p>
        <a href="/roi-call" class="btn btn--primary">Book Your Free ROI Call</a>
      </div>
    </div>
    <div class="footer__bar">
      <p class="footer__copy">© 2026 Homegrown Growth Co. All rights reserved.</p>
      <a class="footer__email" data-obf-email data-eu="ian" data-ed="homegrowngrowth.co">ian [at] homegrowngrowth [dot] co</a>
    </div>
  </div>
</footer>

<script>
  // Assemble the footer email links at runtime so bots scraping the static
  // HTML never see a plain mailto: address. The address parts live in
  // data-eu / data-ed; the visible link keeps a human-readable "[at]/[dot]"
  // fallback for the no-JS case, which JS upgrades to the clean address.
  document.querySelectorAll('a[data-obf-email]').forEach((el) => {
    const user = el.getAttribute('data-eu');
    const domain = el.getAttribute('data-ed');
    if (!user || !domain) return;
    const addr = user + '@' + domain;
    el.setAttribute('href', 'mailto:' + addr);
    if (el.textContent && el.textContent.indexOf('[at]') !== -1) {
      el.textContent = addr;
    }
  });
</script>
