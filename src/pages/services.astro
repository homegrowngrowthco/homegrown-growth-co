---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';

const title = 'Services | Homegrown Growth Co.';
const description = 'A fractional growth partner across nine capabilities: SEO/GEO, demand gen, GTM strategy, CRM, reporting, sales comp, workflows, RevOps, and tech stack audits.';
const canonical = 'https://homegrowngrowth.co/services';

const provider = { '@type': 'Organization', name: 'Homegrown Growth Co.', url: 'https://homegrowngrowth.co' };

const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: title,
  description: 'Nine capabilities across three pillars: Strategy & Operations, Systems & Data, Growth & Acquisition.',
  url: canonical,
  breadcrumb: {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://homegrowngrowth.co/' },
      { '@type': 'ListItem', position: 2, name: 'Services', item: canonical },
    ],
  },
  mainEntity: {
    '@type': 'ItemList',
    itemListElement: [
      { '@type': 'Service', position: 1, name: 'GTM Strategy', description: 'ICP definition, positioning, channel mix, and sales motion design. The strategy work that has to happen before systems and acquisition can pay off.', provider },
      { '@type': 'Service', position: 2, name: 'Fractional RevOps', description: 'Dedicated ops roadmap, weekly standup attendance, cross-functional coordination, and ongoing CRM and reporting ownership. Your part-time VP of RevOps.', provider },
      { '@type': 'Service', position: 3, name: 'Tech Stack Audit', description: 'Complete GTM tool inventory, gap analysis, consolidation recommendations with estimated cost savings, and a prioritized tooling roadmap.', provider },
      { '@type': 'Service', position: 4, name: 'CRM Implementation & Cleanup', description: 'Salesforce or HubSpot built right, or rescued from tech debt. Full audit, structured implementation, data cleaning, migration, and team training.', provider },
      { '@type': 'Service', position: 5, name: 'Reporting & Analytics', description: 'Pipeline analytics, revenue attribution, forecast modeling, and exec-ready dashboards in Salesforce, HubSpot, or your BI tool of choice.', provider },
      { '@type': 'Service', position: 6, name: 'Workflows & Automation', description: 'End-to-end automation design using n8n, Zapier, and Clay. Lead routing, cross-tool data sync, error handling, and documentation included.', provider },
      { '@type': 'Service', position: 7, name: 'Demand Generation', description: 'Paid and organic acquisition, lifecycle marketing, and attribution. Demand that compounds because the measurement and motion are connected.', provider },
      { '@type': 'Service', position: 8, name: 'Website SEO & GEO', description: 'Technical and content SEO, plus Generative Engine Optimization for AI search. Visibility on the surfaces buyers use today.', provider },
      { '@type': 'Service', position: 9, name: 'Sales Comp & Enablement', description: 'Comp plan design, commission modeling, scenario analysis, sales onboarding frameworks, and ramp structure, with documentation for ongoing administration.', provider },
    ],
  },
};

const pillars = [
  {
    name: 'Strategy & Operations',
    eyebrow: 'Pillar 01',
    intro: 'The strategy work and the embedded ownership that have to be in place before systems and acquisition can pay off.',
    services: [
      {
        id: 'gtm-strategy',
        name: 'GTM Strategy',
        hook: 'ICP, positioning, channel mix, and sales motion design. The thinking that has to happen before the systems and the campaigns.',
        bullets: [
          'Ideal Customer Profile definition and tiering, based on real customer data',
          'Positioning and messaging frameworks across personas and channels',
          'Channel mix and sales motion design: PLG, SLG, hybrid, or partner-led',
          'Operating cadence and metrics that connect strategy to execution',
        ],
        fit: [
          'You\'re acquiring customers, but the pattern isn\'t clear or repeatable',
          'You\'re expanding into a new segment or motion and want to derisk it',
          'Your team is doing the right activities, but the strategy underneath is implicit',
        ],
      },
      {
        id: 'fractional-revops',
        name: 'Fractional RevOps',
        hook: 'Your part-time VP of RevOps. Without the full-time price tag or the six-month hiring process.',
        bullets: [
          'Dedicated ops roadmap aligned to your revenue goals and quarterly priorities',
          'Weekly standup attendance and async availability throughout the month',
          'Cross-functional coordination between sales, marketing, and finance operations',
          'Ongoing CRM management, reporting health, and process iteration',
        ],
        fit: [
          'You\'re scaling past $2M ARR and ops is becoming a bottleneck, not a tailwind',
          'Your founder or head of sales is doing too much ops work themselves',
          'You want senior ownership, not task execution, on your revenue stack',
        ],
      },
      {
        id: 'tech-stack-audit',
        name: 'Tech Stack Audit',
        hook: 'A full-system look at what you\'re running, what it\'s costing you, and whether it\'s actually working.',
        bullets: [
          'Complete inventory of GTM tools: usage, cost, overlap, and integration health',
          'Gap analysis against what your current stage and motion actually requires',
          'Consolidation recommendations with estimated cost savings',
          'Prioritized roadmap for tooling changes with rollout sequencing',
        ],
        fit: [
          'You\'re paying for tools that nobody\'s sure are being used',
          'Your stack grew organically and nobody owns the map',
          'You\'re pre-fundraise and want clean, defensible ops infrastructure',
        ],
      },
    ],
  },
  {
    name: 'Systems & Data',
    eyebrow: 'Pillar 02',
    intro: 'The CRM, the reporting layer, and the automation that make the rest of the business measurable and operable.',
    services: [
      {
        id: 'crm-implementation',
        name: 'CRM Implementation & Cleanup',
        hook: 'Salesforce or HubSpot built right the first time, or rescued from years of accumulated tech debt.',
        bullets: [
          'Full audit of existing setup: data model, field logic, automation conflicts, and user adoption gaps',
          'Structured implementation scoped to how your team actually sells, not a template',
          'Data cleaning, deduplication, and migration with zero data loss protocols',
          'Handoff documentation and team training so adoption sticks after the engagement closes',
        ],
        fit: [
          'Your CRM is a graveyard: reps log minimally, data is stale, reports are useless',
          'You\'re migrating from one CRM to another and can\'t afford to get it wrong',
          'You\'ve grown past your original CRM setup and need it rebuilt for where you are now',
        ],
      },
      {
        id: 'reporting-analytics',
        name: 'Reporting & Analytics',
        hook: 'Dashboards that support real decisions, not vanity metrics and pipeline snapshots nobody reads.',
        bullets: [
          'Pipeline analytics: stage velocity, conversion rates, deal quality scoring',
          'Revenue attribution across channels, campaigns, and sourcing motions',
          'Forecast modeling with variance tracking and rep-level visibility',
          'Exec-ready dashboards in Salesforce, HubSpot, or your BI tool of choice',
        ],
        fit: [
          'Your weekly forecast is a gut call, not a data-backed number',
          'You can\'t tell which channels, reps, or segments are actually driving revenue',
          'Board reporting takes days to assemble because the data isn\'t structured',
        ],
      },
      {
        id: 'process-automation',
        name: 'Workflows & Automation',
        hook: 'Replace manual handoffs and tribal knowledge with workflows that run the same way every time.',
        bullets: [
          'End-to-end automation design using n8n, Zapier, and Clay. Scoped, documented, tested.',
          'Lead routing and assignment logic that lives in a system, not someone\'s head',
          'Cross-tool data sync between CRM, marketing platform, billing, and finance systems',
          'Monitoring, error handling, and maintenance documentation included',
        ],
        fit: [
          'Your team is spending hours per week on work that should be automatic',
          'Leads fall through the cracks because handoff processes aren\'t systematic',
          'You have tools that don\'t talk to each other, creating data gaps',
        ],
      },
    ],
  },
  {
    name: 'Growth & Acquisition',
    eyebrow: 'Pillar 03',
    intro: 'The motion that brings new pipeline in, the visibility that gets you found, and the comp structure that aligns the team.',
    services: [
      {
        id: 'demand-generation',
        name: 'Demand Generation',
        hook: 'Paid and organic acquisition that compounds because the measurement and motion are connected.',
        bullets: [
          'Channel strategy across paid social, paid search, organic content, and lifecycle',
          'Campaign briefing, launch, and iteration with clear CPL and pipeline targets',
          'Attribution and reporting that ties spend to closed-won revenue',
          'Lifecycle marketing: nurture, reactivation, and customer marketing motions',
        ],
        fit: [
          'You\'re spending on demand gen but can\'t tell what\'s working',
          'Your CAC is climbing and the channel mix hasn\'t been revisited in a year',
          'You have an audience but no system for converting them to pipeline',
        ],
      },
      {
        id: 'website-seo-geo',
        name: 'Website SEO & GEO',
        hook: 'Technical and content SEO, plus Generative Engine Optimization for AI search. Visibility on the surfaces buyers actually use.',
        bullets: [
          'Technical SEO audit: site architecture, indexation, schema, Core Web Vitals',
          'Content strategy and on-page optimization for the queries your buyers run',
          'GEO: schema, content patterns, and entity structuring for ChatGPT, Perplexity, and Google AI Overviews',
          'Local SEO and multi-location optimization where applicable',
        ],
        fit: [
          'You\'re investing in content but it doesn\'t rank',
          'AI search is starting to send (or steal) traffic and you don\'t have a strategy',
          'You\'re a local or multi-location business and the local pack is the channel',
        ],
      },
      {
        id: 'sales-comp',
        name: 'Sales Comp & Enablement',
        hook: 'Commission plans that drive the right behavior, and onboarding that gets reps productive faster.',
        bullets: [
          'Comp plan design: quota-setting, OTE structure, accelerators, and SPIFFs',
          'Commission modeling and scenario analysis to stress-test plan economics',
          'Sales onboarding frameworks: ramp structure, enablement content, and certification milestones',
          'Handoff to your team with templates and documentation for ongoing administration',
        ],
        fit: [
          'Your comp plan is a spreadsheet that hasn\'t been revisited since you hired your first rep',
          'You\'re scaling the sales team and need a repeatable ramp program',
          'Reps are hitting quota but not driving the margin or segment mix you need',
        ],
      },
    ],
  },
];

// Alternate row backgrounds across the flattened service list
const allServices = pillars.flatMap((p) => p.services);
const bgFor = (idx: number) => (idx % 2 === 0 ? 'var(--color-surface)' : 'var(--color-bg)');
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  schema={schema}
>
  <main id="main" class="page-content">

    <PageHero
      tag="Services"
      headline="Growth operations done end-to-end, or just the piece you need."
      subtitle="Nine capabilities across three pillars. From scoped projects to ongoing embedded support, we work across the entire operations stack. We'll meet you where you are."
      heroImage="/images/hero-strategy.jpg"
      heroImageAlt="Strategy planning workspace"
    />

    {pillars.map((pillar, pillarIdx) => (
      <div class="services-pillar-section">
        <div class="container">
          <div class="services-pillar-header fade-up">
            <span class="services-pillar-eyebrow">{pillar.eyebrow}</span>
            <h2 class="services-pillar-title">{pillar.name}</h2>
            <p class="services-pillar-intro">{pillar.intro}</p>
          </div>
        </div>
        {pillar.services.map((row, rowIdxInPillar) => {
          const flatIdx = pillars.slice(0, pillarIdx).reduce((acc, p) => acc + p.services.length, 0) + rowIdxInPillar;
          const isLastOverall = flatIdx === allServices.length - 1;
          return (
            <div id={row.id} style={`background: ${bgFor(flatIdx)};`}>
              <div class="container">
                <div class="service-row fade-up" style={isLastOverall ? 'border-bottom: none;' : undefined}>
                  <div class="service-row__left">
                    <h3 class="service-row__name">{row.name}</h3>
                    <p class="service-row__hook">{row.hook}</p>
                    <ul class="service-row__bullets" aria-label="What's included">
                      {row.bullets.map((b) => <li class="service-row__bullet">{b}</li>)}
                    </ul>
                  </div>
                  <div class="service-row__fit">
                    <p class="service-row__fit-title">Good fit if...</p>
                    {row.fit.map((f) => (
                      <div class="service-row__fit-item">
                        <span class="fit-check" aria-hidden="true"></span>
                        <span>{f}</span>
                      </div>
                    ))}
                  </div>
                </div>
              </div>
            </div>
          );
        })}
      </div>
    ))}

    <section class="section section--surface" aria-labelledby="engagement-heading">
      <div class="container">
        <div class="section-header section-header--center fade-up">
          <span class="section-eyebrow">How We Work</span>
          <h2 class="display-lg section-title" id="engagement-heading">Four ways to engage.</h2>
          <p class="section-subtitle mx-auto">Retainer for ongoing ownership. Project for a defined deliverable. Outcome-based when the metric is clean. Assessment for a senior diagnostic. <a href="/pricing" class="link-teal">See engagement models →</a></p>
        </div>
      </div>
    </section>

    <section class="cta-section" aria-label="Call to action">
      <div class="container container--narrow text-center">
        <div class="fade-up">
          <h2 class="display-lg section-title title--on-dark-spaced">Not sure where to start?<br />Book a free ROI call.</h2>
          <p class="cta-body">No pitch, no proposal. An honest conversation about where revenue is leaking, what's possible if it's rebuilt, and what would actually move the needle.</p>
          <a href="/roi-call" class="btn btn--white btn--lg">Book Your Free ROI Call</a>
        </div>
      </div>
    </section>

  </main>
</BaseLayout>
