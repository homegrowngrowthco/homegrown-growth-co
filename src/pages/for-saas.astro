---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';

const title = 'Growth Operations for Early-Stage SaaS — Homegrown Growth Co.';
const description = "Fractional growth operations for seed to Series B SaaS teams. CRM, automation, pipeline analytics, and GTM strategy — without the full-time ops hire.";
const canonical = 'https://homegrowngrowth.co/for-saas';

const faqs = [
  { q: 'Do I need fractional ops or a full-time hire?', a: "Most teams between $500K–$5M ARR don't need (or can't justify) a full-time RevOps hire. Fractional gives you senior ownership at 20–30% of the cost, with the ability to scale up or exit cleanly as the company matures." },
  { q: 'How quickly can work actually start?', a: 'Discovery typically takes 1–2 weeks. Depending on scope, the first deliverables are usually in production within 3–4 weeks of the initial call. No months-long "assessment phase" before anything is built.' },
  { q: 'We already have a CRM — do we need this?', a: 'Usually. "We already have a CRM" frequently means it was set up for a different motion and nobody wants to say it\'s not working. The discovery is direct about what\'s actually there, not what it was supposed to be.' },
  { q: 'How do you measure success?', a: 'Metrics get agreed on before the engagement starts — typically: manual time saved, data accuracy improvement, pipeline visibility, and adoption. Not activity metrics like "hours logged" or "tasks completed."' },
  { q: 'Can you work alongside our existing team?', a: 'Yes — this is embedded, not advisory. Work happens inside your tools. Clear async communication, documentation that outlasts the engagement, and no disappearing act between deliverables.' },
  { q: 'What does a project engagement look like?', a: 'Fixed deliverable, clear timeline, defined exit point. Best for CRM migrations, reporting buildouts, automation design, or comp plan overhauls. Priced fixed or T&M depending on scope. No ongoing commitment required.' },
];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: title,
  description,
  url: canonical,
  breadcrumb: {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://homegrowngrowth.co/' },
      { '@type': 'ListItem', position: 2, name: 'For SaaS Teams', item: canonical },
    ],
  },
  mainEntity: {
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
};

const painPoints = [
  { icon: '📊', title: 'Your pipeline data is a guess', body: 'Weekly forecast is whatever the rep said in standup. Nobody knows conversion rates. Board prep takes two days of manual spreadsheet work.' },
  { icon: '🔁', title: "Manual work that shouldn't exist", body: "Lead handoffs live in Slack. Data entry nobody trusts. Sequences that break when a rep leaves. Everything works until it doesn't." },
  { icon: '🏗️', title: 'CRM built for what you were, not what you are', body: "Set up when you had two reps and a simple motion. Now you have segments, channels, and a product line the original setup can't model." },
  { icon: '💸', title: 'Comp plan nobody fully understands', body: "Reps dispute numbers monthly. Finance reconciles quarterly. The plan made sense in year one — it doesn't reflect how you sell anymore." },
  { icon: '🧰', title: 'Too many tools, unclear ROI', body: "Stack grew one integration at a time. Now you're paying for five tools with overlapping features and nobody owns the map of what connects to what." },
  { icon: '⏳', title: 'Your founder is still doing ops work', body: 'RevOps fell to the CEO or head of sales because nobody else owned it. The work is getting done — just by the wrong person at the wrong cost.' },
];

const saasServices = [
  { tag: 'Fractional / Ongoing', title: 'Embedded Growth Ops', body: 'Acting as your part-time VP of RevOps — owning the roadmap and executing across your full GTM system month to month.', bullets: ['Dedicated ops roadmap tied to your revenue goals', 'Weekly standup + async availability', 'Cross-functional coordination: sales, marketing, finance', 'Ongoing CRM health, reporting, and process iteration'] },
  { tag: 'Project', title: 'CRM Implementation & Rebuild', body: 'HubSpot or Salesforce — built right the first time, or rescued from accumulated tech debt before it gets worse.', bullets: ['Full audit: data model, field logic, automation conflicts', 'Implementation scoped to how your team actually sells', 'Data cleaning, deduplication, migration', 'Handoff docs and team training included'] },
  { tag: 'Project', title: 'Automation & Workflow Design', body: 'Manual handoffs and tribal knowledge replaced with documented systems using n8n, Zapier, and Clay.', bullets: ['Lead routing and assignment logic in a system, not Slack', 'Cross-tool data sync between CRM, MAP, billing, finance', 'Error handling and maintenance documentation', 'AI-augmented workflows where they actually add value'] },
  { tag: 'Project / Ongoing', title: 'Pipeline Analytics & Forecasting', body: 'Dashboards that support real decisions — stage velocity, attribution, forecast confidence, and board-ready reporting.', bullets: ['Pipeline analytics: velocity, conversion, deal quality', 'Revenue attribution across channels and sourcing motions', 'Forecast modeling with rep-level visibility', 'Delivered in Salesforce, HubSpot, or your BI tool'] },
  { tag: 'Project', title: 'Sales Comp & Enablement', body: 'Commission plans that incentivize the right behaviors — with the modeling to stress-test before you roll out.', bullets: ['Quota-setting, OTE structure, accelerators, SPIFFs', 'Scenario modeling to test plan economics', 'Rep onboarding frameworks and ramp structure', 'Templates for ongoing administration'] },
  { tag: 'Assessment', title: 'GTM Tech Stack Audit', body: "A full system look at what you're running, what it's costing, and whether it's returning anything close to what you're paying.", bullets: ['Complete inventory: usage, cost, overlap, integration health', 'Gap analysis against your actual stage and motion', 'Consolidation recommendations with estimated savings', 'Prioritized roadmap for changes with rollout sequencing'] },
];

const processSteps = [
  { num: '01', title: 'Free Strategy Call', body: '30 minutes. Honest conversation about where your ops are costing you time and money. No pitch until there\'s a real problem to solve.' },
  { num: '02', title: 'Structured Discovery', body: 'We document your current motion, stack, data model, and friction points before anything gets built. This shapes the scope and the sequencing.' },
  { num: '03', title: 'Scoped Proposal', body: 'Clear deliverables, timeline, and pricing — either as a monthly retainer or a fixed-scope project. No open-ended retainers with vague outputs.' },
  { num: '04', title: 'Embedded Execution', body: 'Work happens inside your tools. Async updates, weekly standups, and full documentation so nothing is a black box when the engagement ends.' },
];

const stats = [
  { number: '20–30%', label: 'Typical cost vs. a full-time RevOps hire at equivalent seniority' },
  { number: '2–4 wks', label: 'From first call to active roadmap and first deliverable in production' },
  { number: 'Hours/week', label: 'Average manual time reclaimed per engagement through automation' },
  { number: '8+ yrs', label: 'RevOps experience across SaaS, healthcare, and high-growth teams' },
];

const fitGood = [
  'Seed to Series B SaaS, $500K–$10M ARR',
  'Growing sales team without a dedicated ops owner',
  'Founder or head of sales is doing too much ops themselves',
  'HubSpot or Salesforce is in-place but underleveraged',
  'Pre-fundraise and need clean, defensible ops infrastructure',
  'Specific high-stakes project: CRM rebuild, comp plan, reporting overhaul',
];

const fitBad = [
  'Pre-revenue or still finding product-market fit',
  'Looking for someone to manage a fully-built system with no improvement scope',
  'Need a full-time, in-office ops resource',
  'No internal champion or decision-maker to work with',
  'Timeline requires faster delivery than a quality engagement allows',
];
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  schema={schema}
>
  <main id="main" class="page-content">

    <PageHero
      tag="For Early-Stage SaaS Teams"
      headline="Your GTM is outgrowing your current systems."
      subtitle="Fractional growth operations for seed to Series B teams — pipeline analytics, CRM, automation, and comp — built for the speed you're moving at."
      headlineMaxWidth="820px"
    />

    <div class="container" style="margin-top: -32px; margin-bottom: 24px;">
      <div class="btn-group fade-up fade-up-delay-3" style="justify-content: center;">
        <a href="/roi-call" class="btn btn--primary btn--lg">Book a Free Strategy Call</a>
        <a href="/services" class="btn btn--outline btn--lg">See what's included</a>
      </div>
    </div>

    <section class="proof-strip-section" aria-label="Who this is for">
      <div class="container">
        <div class="proof-strip fade-up">
          <span class="proof-strip__label">Built for teams that are</span>
          <div class="proof-strip__items">
            <span class="proof-strip__item">Post-product, pre-scale</span>
            <span class="proof-strip__item">HubSpot or Salesforce shops</span>
            <span class="proof-strip__item">Hiring their first reps</span>
            <span class="proof-strip__item">Raising or just raised</span>
          </div>
        </div>
      </div>
    </section>

    <section class="section section--bg" aria-labelledby="pain-heading">
      <div class="container">
        <div class="section-header section-header--center fade-up" style="margin-bottom: 48px;">
          <span class="section-eyebrow">Sound familiar?</span>
          <h2 class="display-md section-title" id="pain-heading">Your ops are holding your growth back.</h2>
          <p class="section-subtitle mx-auto">These are the patterns that show up at every SaaS company between $500K and $5M ARR.</p>
        </div>

        <div class="pain-grid">
          {painPoints.map((p, i) => (
            <div class:list={['pain-card', 'fade-up', `fade-up-delay-${(i % 3) + 1}`]}>
              <div class="pain-card__icon" aria-hidden="true">{p.icon}</div>
              <h3 class="pain-card__title">{p.title}</h3>
              <p class="pain-card__body">{p.body}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="section section--surface" aria-labelledby="saas-services-heading">
      <div class="container">
        <div class="section-header section-header--center fade-up" style="margin-bottom: 48px;">
          <span class="section-eyebrow">What We Build</span>
          <h2 class="display-md section-title" id="saas-services-heading">The full stack, or just the piece you need.</h2>
          <p class="section-subtitle mx-auto">Every engagement starts with a structured discovery. Nothing gets built until there's a clear picture of your motion and where the friction is.</p>
        </div>

        <div class="saas-services-grid">
          {saasServices.map((s, i) => (
            <div class:list={['saas-service-card', 'fade-up', `fade-up-delay-${(i % 3) + 1}`]}>
              <span class="saas-service-card__tag">{s.tag}</span>
              <h3 class="saas-service-card__title">{s.title}</h3>
              <p class="saas-service-card__body">{s.body}</p>
              <ul class="saas-service-card__bullets">
                {s.bullets.map((b) => <li>{b}</li>)}
              </ul>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="dark-section" aria-labelledby="process-heading">
      <div class="container">
        <div class="section-header fade-up">
          <span class="section-eyebrow section-eyebrow--light">How It Works</span>
          <h2 class="display-lg section-title" id="process-heading" style="color:#fff;">From first call to live systems in weeks.</h2>
        </div>
        <p style="color: rgba(255,255,255,0.7); max-width: 640px; margin: -16px 0 40px; font-size: 1.0625rem; line-height: 1.7;" class="fade-up">No discovery that drags on for months. No deliverables that sit in a Google Drive folder.</p>

        <div class="scenario-grid">
          {processSteps.map((s, i) => (
            <div class:list={['scenario-card', 'fade-up', `fade-up-delay-${i + 1}`]}>
              <span class="scenario-card__num">{s.num}</span>
              <h3 class="scenario-card__title">{s.title}</h3>
              <p class="scenario-card__desc">{s.body}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="section section--surface" aria-labelledby="stats-heading">
      <div class="container">
        <div class="section-header section-header--center fade-up" style="margin-bottom: 48px;">
          <span class="section-eyebrow">What This Looks Like</span>
          <h2 class="display-md section-title" id="stats-heading">Outcomes, not activity.</h2>
          <p class="section-subtitle mx-auto">Every engagement ties deliverables to measurable improvements. These are the benchmarks we track.</p>
        </div>

        <div class="stat-grid">
          {stats.map((s, i) => (
            <div class:list={['stat-card', 'fade-up', `fade-up-delay-${(i % 3) + 1}`]}>
              <div class="stat-card__number">{s.number}</div>
              <div class="stat-card__label">{s.label}</div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="section section--bg" aria-labelledby="fit-heading">
      <div class="container container--narrow">
        <div class="section-header section-header--center fade-up" style="margin-bottom: 48px;">
          <span class="section-eyebrow">Who This Is For</span>
          <h2 class="display-md section-title" id="fit-heading">Good fit vs. not.</h2>
          <p class="section-subtitle mx-auto">This works best in specific conditions. If you're not in that zone, I'll tell you on the first call.</p>
        </div>

        <div class="fit-cols">
          <div class="fit-col fit-col--good fade-up">
            <div class="fit-col__label">✓ Strong Fit</div>
            <ul class="fit-list">
              {fitGood.map((f) => (
                <li class="fit-list__item"><span class="fit-list__icon" aria-hidden="true">✓</span><span>{f}</span></li>
              ))}
            </ul>
          </div>
          <div class="fit-col fit-col--bad fade-up fade-up-delay-1">
            <div class="fit-col__label">— Not the Right Fit</div>
            <ul class="fit-list">
              {fitBad.map((f) => (
                <li class="fit-list__item"><span class="fit-list__icon fit-list__icon--muted" aria-hidden="true">✗</span><span>{f}</span></li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </section>

    <section class="section section--surface" aria-labelledby="saas-faq-heading">
      <div class="container container--narrow">
        <div class="section-header fade-up" style="margin-bottom: 40px;">
          <span class="section-eyebrow">FAQ</span>
          <h2 class="display-md section-title" id="saas-faq-heading">Common questions.</h2>
        </div>
        <div class="faq-stack">
          {faqs.map((f) => (
            <div class="faq-item fade-up">
              <h3 class="faq-item__q">{f.q}</h3>
              <p class="faq-item__a">{f.a}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="cta-section" aria-label="Call to action">
      <div class="container container--narrow text-center">
        <div class="fade-up">
          <h2 class="display-lg section-title" style="color:#fff; margin-bottom: 20px;">Ready to stop doing ops work yourself?</h2>
          <p class="cta-body">A free 30-minute call to find out exactly where your GTM is costing you time and money — and whether this is the right fit. No pitch, no proposal — just an honest conversation.</p>
          <a href="/roi-call" class="btn btn--white btn--lg">Book Your Free Strategy Call</a>
        </div>
      </div>
    </section>

  </main>
</BaseLayout>
