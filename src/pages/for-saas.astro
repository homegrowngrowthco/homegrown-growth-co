---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';

const title = 'Growth Operations for Early-Stage SaaS | Homegrown Growth Co.';
const description = "A fractional growth partner for seed to Series B SaaS teams. GTM strategy, RevOps, demand gen, SEO and GEO, CRM, and automation, owned end-to-end without the full-time ops hire.";
const canonical = 'https://homegrowngrowth.co/for-saas';

const faqs = [
  { q: 'Do I need an embedded senior partner or a full-time hire?', a: "Most teams between $500K-$5M ARR don't need (or can't justify) a full-time growth ops hire. An embedded senior partner gives you the same ownership at 20-30% of the cost, with the ability to scale up or exit cleanly as the company matures." },
  { q: 'Do I need the whole umbrella, or just one piece?', a: "Most engagements start with one or two capabilities, not all nine. The discovery surfaces which one moves the needle first. CRM rebuild, GTM motion reset, or paid channel restructure are common starting points. The reason the umbrella matters is that one senior partner owns the connections between them, not that every engagement covers all of it." },
  { q: 'How quickly can work actually start?', a: 'Discovery typically takes 1-2 weeks. Depending on scope, the first deliverables are usually in production within 3-4 weeks of the initial call. No months-long "assessment phase" before anything is built.' },
  { q: 'We already have a CRM. Do we need this?', a: 'Usually. "We already have a CRM" frequently means it was set up for a different motion and nobody wants to say it\'s not working. The discovery is direct about what\'s actually there, not what it was supposed to be.' },
  { q: 'How do you measure success?', a: 'Metrics get agreed on before the engagement starts. Typically: pipeline forecast accuracy, CAC or CPL movement, manual time saved, data accuracy improvement, and adoption. Not activity metrics like "hours logged" or "tasks completed."' },
  { q: 'Can you work alongside our existing team?', a: 'Yes. This is embedded, not advisory. Work happens inside your tools. Clear async communication, documentation that outlasts the engagement, and no disappearing act between deliverables.' },
  { q: 'What does a project engagement look like?', a: 'Fixed deliverable, clear timeline, defined exit point. Best for CRM migrations, reporting buildouts, demand gen restructures, SEO and GEO overhauls, automation design, or comp plan rebuilds. Priced fixed or T&M depending on scope. No ongoing commitment required.' },
];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: title,
  description,
  url: canonical,
  breadcrumb: {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://homegrowngrowth.co/' },
      { '@type': 'ListItem', position: 2, name: 'For SaaS Teams', item: canonical },
    ],
  },
  mainEntity: {
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
};

const painPoints = [
  { icon: '📊', title: 'Your pipeline data is a guess', body: 'Weekly forecast is whatever the rep said in standup. Nobody knows conversion rates. Board prep takes two days of manual spreadsheet work.' },
  { icon: '🎯', title: "GTM motion isn't repeatable yet", body: "You're closing customers, but the pattern isn't predictable. CAC climbs each quarter, the playbook lives in someone's head, and every new rep relearns it from scratch." },
  { icon: '🏗️', title: 'CRM built for what you were, not what you are', body: "Set up when you had two reps and a simple motion. Now you have segments, channels, and a product line the original setup can't model." },
  { icon: '🔁', title: "Manual handoffs that shouldn't exist", body: "Lead routing lives in Slack. Data entry nobody trusts. Sequences that break when a rep leaves. Everything works until it doesn't." },
  { icon: '📡', title: 'Acquisition stalled and AI search is invisible', body: 'Paid channels plateaued. Organic traffic flat. ChatGPT, Perplexity, and Google AI Overviews are starting to send buyers, but you are not on those surfaces. The next dollar of spend is not clearly the right one.' },
  { icon: '⏳', title: 'Your founder is still doing ops work', body: 'Growth ops fell to the CEO or head of sales because nobody else owned it. The work is getting done, just by the wrong person at the wrong cost.' },
];

const saasServices = [
  { tag: 'Project / Ongoing', title: 'GTM Strategy', body: 'ICP, positioning, channel mix, and motion design. The thinking that has to happen before pipeline and ops can pay off.', bullets: ['Ideal Customer Profile definition and tiering, based on real customer data', 'Positioning and messaging frameworks for each persona and channel', 'Channel mix and motion design: PLG, SLG, hybrid, or partner-led', 'Operating cadence and metrics that connect strategy to weekly execution'] },
  { tag: 'Embedded / Ongoing', title: 'Fractional RevOps', body: 'Your part-time VP of RevOps. Owning the roadmap and executing across your full revenue stack month to month.', bullets: ['Dedicated ops roadmap tied to your revenue goals and quarterly priorities', 'Weekly standup attendance and async availability throughout the month', 'Cross-functional coordination across sales, marketing, and finance ops', 'Ongoing CRM health, reporting, and process iteration'] },
  { tag: 'Assessment', title: 'Tech Stack Audit', body: "A full-system look at what you're running, what it's costing, and whether it's returning anything close to what you're paying.", bullets: ['Complete inventory of GTM tools: usage, cost, overlap, integration health', 'Gap analysis against your actual stage and motion', 'Consolidation recommendations with estimated cost savings', 'Prioritized roadmap for tooling changes with rollout sequencing'] },
  { tag: 'Project', title: 'CRM Implementation & Cleanup', body: 'HubSpot or Salesforce, built right the first time, or rescued from accumulated tech debt before it gets worse.', bullets: ['Full audit: data model, field logic, automation conflicts, adoption gaps', 'Implementation scoped to how your team actually sells', 'Data cleaning, deduplication, and migration with zero data loss protocols', 'Handoff docs and team training included'] },
  { tag: 'Project / Ongoing', title: 'Reporting & Analytics', body: 'Dashboards that support real decisions: stage velocity, attribution, forecast confidence, and board-ready reporting.', bullets: ['Pipeline analytics: velocity, conversion, deal quality scoring', 'Revenue attribution across channels, campaigns, and sourcing motions', 'Forecast modeling with variance tracking and rep-level visibility', 'Delivered in Salesforce, HubSpot, or your BI tool of choice'] },
  { tag: 'Project', title: 'Workflows & Automation', body: 'Manual handoffs and tribal knowledge replaced with documented systems using n8n, Zapier, and Clay.', bullets: ['Lead routing and assignment logic in a system, not Slack', 'Cross-tool data sync between CRM, MAP, billing, and finance', 'Monitoring, error handling, and maintenance documentation included', 'AI-augmented workflows where they actually add value'] },
  { tag: 'Project / Ongoing', title: 'Demand Generation', body: 'Paid and organic acquisition tied to closed-won revenue. Demand that compounds because the measurement and the motion are connected.', bullets: ['Channel strategy across paid search, paid social, organic content, lifecycle', 'Campaign briefing, launch, and iteration with clear CPL and pipeline targets', 'Attribution from spend through to closed-won revenue', 'Lifecycle nurture, reactivation, and customer marketing motions'] },
  { tag: 'Project / Ongoing', title: 'Website SEO & GEO', body: 'Technical and content SEO, plus Generative Engine Optimization for AI search. Visibility on the surfaces your buyers actually use.', bullets: ['Technical SEO audit: site architecture, indexation, schema, Core Web Vitals', 'Content strategy and on-page optimization for the queries your buyers run', 'GEO: entity structuring for ChatGPT, Perplexity, and Google AI Overviews', 'Topical authority planning aligned to your ICP and motion'] },
  { tag: 'Project', title: 'Sales Comp & Enablement', body: 'Commission plans that incentivize the right behaviors, with the modeling to stress-test before you roll out.', bullets: ['Comp plan design: quota-setting, OTE structure, accelerators, SPIFFs', 'Scenario modeling and commission analysis to stress-test plan economics', 'Rep onboarding frameworks and ramp structure with certification milestones', 'Templates and documentation for ongoing administration'] },
];

const processSteps = [
  { num: '01', title: 'Free Strategy Call', body: '30 minutes. Honest conversation about where your ops are costing you time and money. No pitch until there\'s a real problem to solve.' },
  { num: '02', title: 'Structured Discovery', body: 'We document your current motion, stack, data model, and friction points before anything gets built. This shapes the scope and the sequencing.' },
  { num: '03', title: 'Scoped Proposal', body: 'Clear deliverables, timeline, and pricing, either as a monthly retainer or a fixed-scope project. No open-ended retainers with vague outputs.' },
  { num: '04', title: 'Embedded Execution', body: 'Work happens inside your tools. Async updates, weekly standups, and full documentation so nothing is a black box when the engagement ends.' },
];

const stats = [
  { number: '20-30%', label: 'Typical cost vs. a full-time senior growth ops hire at equivalent seniority' },
  { number: '2-4 wks', label: 'From first call to active roadmap and first deliverable in production' },
  { number: '10+ hrs', label: 'Per week reclaimed once automation and routing are live' },
  { number: '8+ yrs', label: 'Senior growth ops experience across SaaS, healthcare, and high-growth teams' },
];

const fitGood = [
  'Seed to Series B SaaS, $500K-$10M ARR',
  'Growing sales team without a dedicated ops owner',
  'Founder or head of sales is doing too much ops themselves',
  'HubSpot or Salesforce is in-place but underleveraged',
  'Pre-fundraise and need clean, defensible ops infrastructure',
  'Specific high-stakes project: CRM rebuild, comp plan, reporting overhaul',
];

const fitBad = [
  'Pre-revenue or still finding product-market fit',
  'Looking for someone to manage a fully-built system with no improvement scope',
  'Need a full-time, in-office ops resource',
  'No internal champion or decision-maker to work with',
  'Timeline requires faster delivery than a quality engagement allows',
];
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  schema={schema}
>
  <main id="main" class="page-content">

    <PageHero
      tag="For Early-Stage SaaS Teams"
      headline="Your GTM is outgrowing your current systems."
      subtitle="A fractional growth partner for seed to Series B teams. GTM strategy, RevOps, demand gen, SEO and GEO, and the systems behind them. Owned end-to-end so your founder isn't."
      headlineMaxWidth="820px"
      heroImage="/images/hero-saas.jpg"
      heroImageAlt="Modern SaaS team workspace"
    />

    <div class="container" style="margin-top: -32px; margin-bottom: 24px;">
      <div class="btn-group fade-up fade-up-delay-3" style="justify-content: center;">
        <a href="/roi-call" class="btn btn--primary btn--lg">Book a Free Strategy Call</a>
        <a href="/services" class="btn btn--outline btn--lg">See what's included</a>
      </div>
    </div>

    <section class="proof-strip-section" aria-label="Who this is for">
      <div class="container">
        <div class="proof-strip fade-up">
          <span class="proof-strip__label">Built for teams that are</span>
          <div class="proof-strip__items">
            <span class="proof-strip__item">Post-product, pre-scale</span>
            <span class="proof-strip__item">HubSpot or Salesforce shops</span>
            <span class="proof-strip__item">Hiring their first reps</span>
            <span class="proof-strip__item">Raising or just raised</span>
          </div>
        </div>
      </div>
    </section>

    <section class="section section--bg" aria-labelledby="pain-heading">
      <div class="container">
        <div class="section-header section-header--center fade-up" style="margin-bottom: 48px;">
          <span class="section-eyebrow">Sound familiar?</span>
          <h2 class="display-md section-title" id="pain-heading">Where SaaS growth typically leaks.</h2>
          <p class="section-subtitle mx-auto">These patterns show up across every SaaS company between $500K and $5M ARR, regardless of vertical.</p>
        </div>

        <div class="pain-grid">
          {painPoints.map((p, i) => (
            <div class:list={['pain-card', 'fade-up', `fade-up-delay-${(i % 3) + 1}`]}>
              <div class="pain-card__icon" aria-hidden="true">{p.icon}</div>
              <h3 class="pain-card__title">{p.title}</h3>
              <p class="pain-card__body">{p.body}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="section section--surface" aria-labelledby="saas-services-heading">
      <div class="container">
        <div class="section-header section-header--center fade-up" style="margin-bottom: 48px;">
          <span class="section-eyebrow">What We Build</span>
          <h2 class="display-md section-title" id="saas-services-heading">The full stack, or just the piece you need.</h2>
          <p class="section-subtitle mx-auto">Every engagement starts with a structured discovery. Nothing gets built until there's a clear picture of your motion and where the friction is.</p>
        </div>

        <div class="saas-services-grid">
          {saasServices.map((s, i) => (
            <div class:list={['saas-service-card', 'fade-up', `fade-up-delay-${(i % 3) + 1}`]}>
              <span class="saas-service-card__tag">{s.tag}</span>
              <h3 class="saas-service-card__title">{s.title}</h3>
              <p class="saas-service-card__body">{s.body}</p>
              <ul class="saas-service-card__bullets">
                {s.bullets.map((b) => <li>{b}</li>)}
              </ul>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="dark-section" aria-labelledby="process-heading">
      <div class="container">
        <div class="section-header fade-up">
          <span class="section-eyebrow section-eyebrow--light">How It Works</span>
          <h2 class="display-lg section-title" id="process-heading" style="color:#fff;">From first call to live systems in weeks.</h2>
        </div>
        <p style="color: rgba(255,255,255,0.7); max-width: 640px; margin: -16px 0 40px; font-size: 1.0625rem; line-height: 1.7;" class="fade-up">No discovery that drags on for months. No deliverables that sit in a Google Drive folder.</p>

        <div class="scenario-grid">
          {processSteps.map((s, i) => (
            <div class:list={['scenario-card', 'fade-up', `fade-up-delay-${i + 1}`]}>
              <span class="scenario-card__num">{s.num}</span>
              <h3 class="scenario-card__title">{s.title}</h3>
              <p class="scenario-card__desc">{s.body}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="section section--surface" aria-labelledby="stats-heading">
      <div class="container">
        <div class="section-header section-header--center fade-up" style="margin-bottom: 48px;">
          <span class="section-eyebrow">What This Looks Like</span>
          <h2 class="display-md section-title" id="stats-heading">Outcomes, not activity.</h2>
          <p class="section-subtitle mx-auto">Every engagement ties deliverables to measurable improvements. These are the benchmarks we track.</p>
        </div>

        <div class="stat-grid">
          {stats.map((s, i) => (
            <div class:list={['stat-card', 'fade-up', `fade-up-delay-${(i % 3) + 1}`]}>
              <div class="stat-card__number">{s.number}</div>
              <div class="stat-card__label">{s.label}</div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="section section--bg" aria-labelledby="fit-heading">
      <div class="container container--narrow">
        <div class="section-header section-header--center fade-up" style="margin-bottom: 48px;">
          <span class="section-eyebrow">Who This Is For</span>
          <h2 class="display-md section-title" id="fit-heading">Good fit vs. not.</h2>
          <p class="section-subtitle mx-auto">This works best in specific conditions. If you're not in that zone, I'll tell you on the first call.</p>
        </div>

        <div class="fit-cols">
          <div class="fit-col fit-col--good fade-up">
            <div class="fit-col__label">✓ Strong Fit</div>
            <ul class="fit-list">
              {fitGood.map((f) => (
                <li class="fit-list__item"><span class="fit-list__icon" aria-hidden="true">✓</span><span>{f}</span></li>
              ))}
            </ul>
          </div>
          <div class="fit-col fit-col--bad fade-up fade-up-delay-1">
            <div class="fit-col__label">Not the Right Fit</div>
            <ul class="fit-list">
              {fitBad.map((f) => (
                <li class="fit-list__item"><span class="fit-list__icon fit-list__icon--muted" aria-hidden="true">✗</span><span>{f}</span></li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </section>

    <section class="section section--surface" aria-labelledby="saas-faq-heading">
      <div class="container container--narrow">
        <div class="section-header fade-up" style="margin-bottom: 40px;">
          <span class="section-eyebrow">FAQ</span>
          <h2 class="display-md section-title" id="saas-faq-heading">Common questions.</h2>
        </div>
        <div class="faq-stack">
          {faqs.map((f) => (
            <details class="faq-item fade-up">
              <summary class="faq-item__q">
                <span>{f.q}</span>
                <svg class="faq-item__chevron" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 6l5 5 5-5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </summary>
              <p class="faq-item__a">{f.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="cta-section" aria-label="Call to action">
      <div class="container container--narrow text-center">
        <div class="fade-up">
          <h2 class="display-lg section-title" style="color:#fff; margin-bottom: 20px;">Ready to own growth operations end-to-end?</h2>
          <p class="cta-body">A free thirty-minute call to map where your GTM is leaking, what's possible if it's rebuilt, and whether this is a fit. No pitch, no proposal. An honest conversation.</p>
          <a href="/roi-call" class="btn btn--white btn--lg">Book Your Free Strategy Call</a>
        </div>
      </div>
    </section>

  </main>
</BaseLayout>
