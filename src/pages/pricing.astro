---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';

const title = 'Pricing — Homegrown Growth Co.';
const description = 'Transparent fractional RevOps pricing. Monthly retainers from $3,000/month for 5 hours/week up to $10,000/month for 20 hours/week. No long-term lock-in.';
const canonical = 'https://homegrowngrowth.co/pricing';

const faqs = [
  { q: 'Is there a long-term contract?', a: "No. Monthly retainers are month-to-month. Quarterly retainers lock in three months at the stated quarterly price. Either way, there's no multi-year commitment." },
  { q: 'Can I change tiers after we start?', a: 'Yes. If your needs grow or change, we can adjust the engagement level at the start of the next billing period.' },
  { q: "What's the difference between Rate and Effective Hourly?", a: 'Rate is the hourly rate for the tier. Effective Hourly reflects the blended cost per hour across a full month at that commitment level — the monthly retainer divided by the total hours in the month.' },
  { q: 'Do unused hours roll over?', a: "Retainers don't roll over — they're sized to ensure consistent, ongoing availability. If a given month runs light, that headroom typically gets recaptured in deeper work the following month." },
  { q: 'What if I need more hours in a given month?', a: "Occasional overages can be handled at the tier's stated rate. If you consistently need more than your tier covers, we'll revisit the engagement level together." },
  { q: "Where do I start if I'm not sure which tier is right?", a: "Book the free ROI call. We'll talk through where your ops are today, what needs to move, and what level of engagement will actually get you there." },
];

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebPage',
      name: title,
      description: 'Transparent fractional RevOps pricing. Monthly retainers from $3,000/month.',
      url: canonical,
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://homegrowngrowth.co/' },
        { '@type': 'ListItem', position: 2, name: 'Pricing', item: canonical },
      ],
    },
    {
      '@type': 'FAQPage',
      mainEntity: faqs.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
  ],
};

const tiers = [
  {
    name: 'Essential',
    hours: '5 hrs',
    amount: '$3,000',
    quarterly: '$9,000 / quarter',
    rate: '$150 / hr',
    effective: '$138 / hr',
    features: ['Strategic ops advisory & oversight', 'Light ongoing CRM & reporting support', 'Async Slack & email access', 'Monthly ops review'],
    cta: 'btn--outline',
    featured: false,
  },
  {
    name: 'Growth',
    hours: '10 hrs',
    amount: '$5,500',
    quarterly: '$16,500 / quarter',
    rate: '$135 / hr',
    effective: '$127 / hr',
    features: ['Active CRM & process build-out', 'Reporting stack & pipeline analytics', 'Cross-functional coordination', 'Weekly sync & async access'],
    cta: 'btn--primary',
    featured: true,
  },
  {
    name: 'Embedded',
    hours: '20 hrs',
    amount: '$10,000',
    quarterly: '$30,000 / quarter',
    rate: '$120 / hr',
    effective: '$115 / hr',
    features: ['Near full-time fractional ops lead', 'End-to-end GTM build & optimization', 'Attending team standups & meetings', 'Full weekly engagement & reporting'],
    cta: 'btn--outline',
    featured: false,
  },
];
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  schema={schema}
>
  <main id="main" class="page-content">

    <PageHero
      tag="Pricing"
      headline="Transparent retainer pricing. No surprises, no lock-in."
      subtitle="Monthly and quarterly retainers built around your level of ops need. The more hours you commit, the lower your effective rate — and scope can flex across any service HGC offers."
      headlineMaxWidth="780px"
    />

    <section class="section section--surface" aria-labelledby="pricing-heading">
      <div class="container">
        <div class="section-header section-header--center fade-up">
          <span class="section-eyebrow">Retainer Tiers</span>
          <h2 class="display-md section-title" id="pricing-heading">Choose your engagement level</h2>
          <p class="section-subtitle mx-auto">All tiers include direct access to Ian, full access to every service HGC offers, and flexible scope within your weekly hour budget.</p>
        </div>

        <div class="pricing-grid fade-up">
          {tiers.map((t) => (
            <div class:list={['pricing-card', { 'pricing-card--featured': t.featured }]}>
              {t.featured && <div class="pricing-card__badge">Most Popular</div>}
              <div class="pricing-card__header">
                <span class="pricing-card__tier">{t.name}</span>
                <p class="pricing-card__hours">{t.hours} <span>/ week</span></p>
              </div>
              <div class="pricing-card__price">
                <span class="pricing-card__amount">{t.amount}</span>
                <span class="pricing-card__period">/ month</span>
              </div>
              <p class="pricing-card__quarterly">{t.quarterly}</p>
              <div class="pricing-card__rates">
                <div class="pricing-card__rate-row">
                  <span class="pricing-card__rate-label">Rate</span>
                  <span class="pricing-card__rate-value">{t.rate}</span>
                </div>
                <div class="pricing-card__rate-row">
                  <span class="pricing-card__rate-label">Effective hourly</span>
                  <span class="pricing-card__rate-value">{t.effective}</span>
                </div>
              </div>
              <ul class="pricing-card__features" aria-label={`${t.name} tier features`}>
                {t.features.map((f) => <li>{f}</li>)}
              </ul>
              <a href="/roi-call" class:list={['btn', t.cta, 'pricing-card__cta']}>Book a Call</a>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="section section--bg" aria-labelledby="pricing-table-heading">
      <div class="container container--narrow">
        <div class="fade-up">
          <span class="section-eyebrow">Full Breakdown</span>
          <h2 class="display-md section-title" id="pricing-table-heading" class="mb-32">At a glance</h2>
          <div class="pricing-table-wrap">
            <table class="pricing-table" aria-label="Pricing comparison table">
              <thead>
                <tr>
                  <th scope="col">Hours / Week</th>
                  <th scope="col">Rate</th>
                  <th scope="col">Monthly</th>
                  <th scope="col">Quarterly</th>
                  <th scope="col">Effective Hourly</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td>5 hrs</td>
                  <td>$150 / hr</td>
                  <td class="pricing-table__highlight">$3,000</td>
                  <td>$9,000</td>
                  <td>$138 / hr</td>
                </tr>
                <tr class="pricing-table__row--featured">
                  <td>10 hrs</td>
                  <td>$135 / hr</td>
                  <td class="pricing-table__highlight">$5,500</td>
                  <td>$16,500</td>
                  <td>$127 / hr</td>
                </tr>
                <tr>
                  <td>20 hrs</td>
                  <td>$120 / hr</td>
                  <td class="pricing-table__highlight">$10,000</td>
                  <td>$30,000</td>
                  <td>$115 / hr</td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </section>

    <section class="section section--surface" aria-labelledby="included-heading">
      <div class="container container--narrow">
        <div class="fade-up">
          <span class="section-eyebrow">Every Tier</span>
          <h2 class="display-md section-title" id="included-heading" class="mb-36">What's always included</h2>
        </div>
        <div class="pricing-includes-grid fade-up">
          <div class="pricing-include-item">
            <div class="pricing-include-icon" aria-hidden="true">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 7H4a2 2 0 00-2 2v6a2 2 0 002 2h16a2 2 0 002-2V9a2 2 0 00-2-2z"/><path d="M16 21V5a2 2 0 00-2-2h-4a2 2 0 00-2 2v16"/></svg>
            </div>
            <div>
              <p class="pricing-include-title">Direct access to Ian</p>
              <p class="pricing-include-desc">No account managers, no hand-offs. You work directly with the founder on every engagement.</p>
            </div>
          </div>
          <div class="pricing-include-item">
            <div class="pricing-include-icon" aria-hidden="true">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
            </div>
            <div>
              <p class="pricing-include-title">Full service catalog</p>
              <p class="pricing-include-desc">Scope flexes across all HGC services — CRM, automation, reporting, tech stack, comp, and more.</p>
            </div>
          </div>
          <div class="pricing-include-item">
            <div class="pricing-include-icon" aria-hidden="true">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
            </div>
            <div>
              <p class="pricing-include-title">Ops roadmap & reporting</p>
              <p class="pricing-include-desc">A living ops roadmap plus regular updates on what's moving, what's next, and what the ROI looks like.</p>
            </div>
          </div>
          <div class="pricing-include-item">
            <div class="pricing-include-icon" aria-hidden="true">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z"/></svg>
            </div>
            <div>
              <p class="pricing-include-title">Async Slack & email support</p>
              <p class="pricing-include-desc">Questions and blockers don't wait for scheduled meetings. Async access is included in every tier.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="section section--bg" aria-labelledby="faq-heading">
      <div class="container container--narrow">
        <div class="fade-up">
          <span class="section-eyebrow">FAQ</span>
          <h2 class="display-md section-title" id="faq-heading" class="mb-40">Common questions</h2>
        </div>
        <div class="faq-stack fade-up">
          {faqs.map((f) => (
            <div class="faq-item">
              <p class="faq-item__q">{f.q}</p>
              <p class="faq-item__a">{f.a}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="cta-section" aria-label="Call to action">
      <div class="container container--narrow text-center">
        <div class="fade-up">
          <h2 class="display-lg section-title title--on-dark-spaced">Not sure where to start?<br />Book a free ROI call.</h2>
          <p class="cta-body">No pitch, no proposal — just an honest conversation about where your ops are costing you money and what would actually move the needle.</p>
          <a href="/roi-call" class="btn btn--white btn--lg">Book Your Free ROI Call</a>
        </div>
      </div>
    </section>

  </main>
</BaseLayout>
