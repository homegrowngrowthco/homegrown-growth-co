---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';

const title = 'Pricing & Engagement Models | Homegrown Growth Co.';
const description = 'Four ways to engage a fractional growth partner: retainer, fixed-scope project, outcome-based, or one-time assessment. Pricing scoped on the free ROI call.';
const canonical = 'https://homegrowngrowth.co/pricing';

const faqs = [
  { q: 'Why don\'t you list specific prices?', a: 'Because the right scope depends on where your business actually is and what needs to move. Two companies asking for "demand gen help" can have wildly different needs. The free ROI call is a 30-minute conversation to scope what you actually need, after which a clear proposal follows. No surprises on the call itself.' },
  { q: 'How long do engagements typically run?', a: 'Retainers are month-to-month or quarterly, no multi-year lock-in. Projects run on a defined timeline, typically 2-12 weeks. Outcome-based engagements run until the agreed metric is hit. Assessments are 2-3 weeks.' },
  { q: 'Can engagement models flex over time?', a: 'Yes. It\'s common to start with an Assessment, move into a Project for the most urgent fix, then transition to a Retainer once the broader roadmap is clear. Or stay at any single model indefinitely. The structure follows the work.' },
  { q: 'Is there a minimum commitment?', a: 'Retainers have a 3-month minimum to give the work time to compound. Projects, Outcome-based, and Assessments are scoped one-shot and end when the deliverable is met.' },
  { q: 'How do you handle scope changes mid-engagement?', a: 'Retainers absorb scope shifts naturally because the hours are pooled. For Projects, a change order documents the additional scope and timeline impact before any new work starts. No surprise invoices.' },
  { q: 'Where do I start if I\'m not sure which model fits?', a: 'Book the free ROI call. We\'ll talk through where your business is today, what needs to move, and which engagement model fits the situation. If the answer is "you don\'t need us yet," you\'ll hear that too.' },
];

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebPage',
      name: title,
      description: 'Four engagement models for fractional growth work: retainer, project-based, outcome-based, and one-time assessment.',
      url: canonical,
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://homegrowngrowth.co/' },
        { '@type': 'ListItem', position: 2, name: 'Pricing', item: canonical },
      ],
    },
    {
      '@type': 'FAQPage',
      mainEntity: faqs.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
  ],
};

const packages = [
  {
    name: 'Retainer',
    type: 'Ongoing engagement',
    tag: 'Most common',
    featured: true,
    hook: 'Embedded senior ownership across your full operations stack.',
    bestFor: 'Teams that need a consistent senior ops partner, not a one-time fix.',
    includes: [
      'Dedicated ops roadmap aligned to your goals',
      'Weekly cadence and async access between syncs',
      'Scope flexes across any HGC service',
      'Monthly or quarterly billing, month-to-month after a 3-month minimum',
    ],
    howStarts: 'Free ROI call → structured discovery → scoped retainer proposal.',
  },
  {
    name: 'Project-Based',
    type: 'Fixed scope',
    tag: 'Defined deliverable',
    featured: false,
    hook: 'A scoped initiative with a clear deliverable and exit.',
    bestFor: 'A single defined initiative: CRM migration, comp plan design, demand gen audit, SEO migration, dashboard buildout, automation rollout.',
    includes: [
      'Statement of work with deliverables and timeline',
      'Fixed fee or time-and-materials depending on scope',
      'Documented handoff so your team owns it after',
      'Typical duration 2-12 weeks',
    ],
    howStarts: 'Free ROI call → scoping conversation → fixed-scope proposal.',
  },
  {
    name: 'Outcome-Based',
    type: 'Performance-tied',
    tag: 'Skin in the game',
    featured: false,
    hook: 'Compensation tied to a measurable business outcome.',
    bestFor: 'Engagements where the metric is clean and the levers are agreed on: CPL targets, MQL volume, pipeline lift, comp accuracy, attribution clarity.',
    includes: [
      'Baseline measurement before work starts',
      'Agreed metric, time window, and performance bands',
      'Lower base + outcome-tied upside',
      'Quarterly review and recalibration',
    ],
    howStarts: 'Free ROI call → baseline assessment → outcome contract.',
  },
  {
    name: 'Assessment',
    type: 'One-time audit',
    tag: 'Diagnostic',
    featured: false,
    hook: 'A senior diagnostic before you commit to the larger work.',
    bestFor: 'Teams who aren\'t sure what they need or want a structured outside read before signing on for an ongoing engagement.',
    includes: [
      '2-3 week structured audit',
      'Systems, data, motion, and acquisition reviewed',
      'Prioritized recommendations with sizing and sequencing',
      'Findings doc you keep regardless of next step',
    ],
    howStarts: 'Free ROI call → scoped audit proposal.',
  },
];
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  schema={schema}
>
  <main id="main" class="page-content">

    <PageHero
      tag="Pricing & Engagement Models"
      headline="Four ways to engage. Scope first, price second."
      subtitle="Pricing depends on what actually needs to move in your business. The structure follows the work, not the other way around. The free ROI call is where we figure out which model fits."
      headlineMaxWidth="820px"
      heroImage="/images/hero-strategy.jpg"
      heroImageAlt="Engagement model planning"
    />

    <section class="section section--surface" aria-labelledby="packages-heading">
      <div class="container">
        <div class="section-header section-header--center fade-up">
          <span class="section-eyebrow">Engagement Models</span>
          <h2 class="display-md section-title" id="packages-heading">Choose the model that fits the work.</h2>
          <p class="section-subtitle mx-auto">Retainer for ongoing ownership. Project for a defined deliverable. Outcome-based when the metric is clean. Assessment for a senior diagnostic before committing.</p>
        </div>

        <div class="packages-grid fade-up">
          {packages.map((p) => (
            <div class:list={['package-card', { 'package-card--featured': p.featured }]}>
              {p.tag && <div class="package-card__tag">{p.tag}</div>}
              <div class="package-card__header">
                <p class="package-card__type">{p.type}</p>
                <h3 class="package-card__name">{p.name}</h3>
                <p class="package-card__hook">{p.hook}</p>
              </div>
              <div class="package-card__section">
                <p class="package-card__section-title">Best for</p>
                <p class="package-card__body">{p.bestFor}</p>
              </div>
              <div class="package-card__section">
                <p class="package-card__section-title">What's included</p>
                <ul class="package-card__list">
                  {p.includes.map((item) => <li>{item}</li>)}
                </ul>
              </div>
              <div class="package-card__section">
                <p class="package-card__section-title">How it starts</p>
                <p class="package-card__body">{p.howStarts}</p>
              </div>
              <a href="/roi-call" class:list={['btn', p.featured ? 'btn--primary' : 'btn--outline', 'package-card__cta']}>Book a Call</a>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="section section--bg" aria-labelledby="included-heading">
      <div class="container container--narrow">
        <div class="fade-up">
          <span class="section-eyebrow">Every Engagement</span>
          <h2 class="display-md section-title mb-36" id="included-heading">What's always included</h2>
        </div>
        <div class="pricing-includes-grid fade-up">
          <div class="pricing-include-item">
            <div class="pricing-include-icon" aria-hidden="true">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 7H4a2 2 0 00-2 2v6a2 2 0 002 2h16a2 2 0 002-2V9a2 2 0 00-2-2z"/><path d="M16 21V5a2 2 0 00-2-2h-4a2 2 0 00-2 2v16"/></svg>
            </div>
            <div>
              <p class="pricing-include-title">Direct access to Ian</p>
              <p class="pricing-include-desc">No account managers, no hand-offs. You work directly with the founder on every engagement.</p>
            </div>
          </div>
          <div class="pricing-include-item">
            <div class="pricing-include-icon" aria-hidden="true">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
            </div>
            <div>
              <p class="pricing-include-title">Full service catalog</p>
              <p class="pricing-include-desc">Scope flexes across all HGC services: GTM strategy, RevOps, CRM, reporting, automation, demand gen, SEO, comp, and audits.</p>
            </div>
          </div>
          <div class="pricing-include-item">
            <div class="pricing-include-icon" aria-hidden="true">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
            </div>
            <div>
              <p class="pricing-include-title">Roadmap & ROI reporting</p>
              <p class="pricing-include-desc">A living roadmap plus regular updates on what's moving, what's next, and what the ROI looks like.</p>
            </div>
          </div>
          <div class="pricing-include-item">
            <div class="pricing-include-icon" aria-hidden="true">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z"/></svg>
            </div>
            <div>
              <p class="pricing-include-title">Async Slack & email support</p>
              <p class="pricing-include-desc">Questions and blockers don't wait for scheduled meetings. Async access is included in every engagement.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="section section--surface" aria-labelledby="faq-heading">
      <div class="container container--narrow">
        <div class="fade-up">
          <span class="section-eyebrow">FAQ</span>
          <h2 class="display-md section-title mb-40" id="faq-heading">Common questions</h2>
        </div>
        <div class="faq-stack fade-up">
          {faqs.map((f) => (
            <details class="faq-item">
              <summary class="faq-item__q">
                <span>{f.q}</span>
                <svg class="faq-item__chevron" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 6l5 5 5-5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </summary>
              <p class="faq-item__a">{f.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="cta-section" aria-label="Call to action">
      <div class="container container--narrow text-center">
        <div class="fade-up">
          <h2 class="display-lg section-title title--on-dark-spaced">Not sure where to start?<br />Book a free ROI call.</h2>
          <p class="cta-body">No pitch, no proposal. An honest conversation about where revenue is leaking, what's possible if it's rebuilt, and which engagement model would actually fit.</p>
          <a href="/roi-call" class="btn btn--white btn--lg">Book Your Free ROI Call</a>
        </div>
      </div>
    </section>

  </main>
</BaseLayout>
