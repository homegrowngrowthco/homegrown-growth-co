---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'Homegrown Growth Co. | Fractional Growth Operations';
const description = 'Fractional Growth Operations for growing businesses. RevOps, GTM, demand gen, SEO, and workflow automation, owned by one senior partner at fractional cost.';
const canonical = 'https://homegrowngrowth.co/';

const faqs = [
  { q: 'Why fractional instead of a full-time hire?', a: 'A senior growth ops leader fully loaded runs $200K+ before benefits. Most growing businesses get more value from one senior partner at 30% of that cost with the option to scale up or step out without severance and recruiter fees.' },
  { q: "How do I know you'll understand my business?", a: "Every engagement starts with a structured diagnostic. Nothing gets built until there's a clear picture of your motion, your team, and where the actual friction is." },
  { q: 'Can you work with our existing team?', a: 'Yes. This is embedded work, not advisory. Everything happens inside your tools with weekly cadence and documentation, so the team is aligned and nothing lives in my head.' },
  { q: 'What if we only need help for a short period?', a: "Project-based engagements cover defined scopes: a CRM rebuild, a comp plan design, a demand gen audit, an SEO migration. Not everything needs to be ongoing." },
];

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'ProfessionalService',
      name: 'Homegrown Growth Co.',
      description: 'Fractional Growth Operations for growing businesses. GTM strategy, revenue operations, CRM implementation, reporting and analytics, demand generation, website SEO and GEO, workflows and automation, tech stack audits, and sales compensation. Delivered as embedded senior-level support.',
      url: 'https://homegrowngrowth.co',
      email: 'ian@homegrowngrowth.co',
      image: 'https://homegrowngrowth.co/og-image.png',
      priceRange: '$$',
      founder: {
        '@type': 'Person',
        name: 'Ian Chamberland',
        jobTitle: 'Founder & Fractional Growth Operations Consultant',
        knowsAbout: ['Revenue Operations', 'GTM Strategy', 'Demand Generation', 'Search Engine Optimization', 'Generative Engine Optimization', 'CRM Implementation', 'Salesforce', 'HubSpot', 'Sales Compensation', 'Process Automation', 'Workflow Automation'],
        hasCredential: '8+ years Revenue Operations experience, including Head of Global Revenue Operations',
      },
      address: { '@type': 'PostalAddress', addressLocality: 'Massachusetts', addressRegion: 'MA', addressCountry: 'US' },
      areaServed: ['Massachusetts', 'New England', 'United States'],
      hasOfferCatalog: {
        '@type': 'OfferCatalog',
        name: 'Growth Operations Services',
        itemListElement: [
          { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'GTM Strategy' } },
          { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Fractional RevOps' } },
          { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Tech Stack Audit' } },
          { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'CRM Implementation & Cleanup' } },
          { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Reporting & Analytics' } },
          { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Workflows & Automation' } },
          { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Demand Generation' } },
          { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Website SEO & GEO' } },
          { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Sales Comp & Enablement' } },
        ],
      },
      knowsAbout: ['Salesforce', 'HubSpot', 'Revenue Operations', 'GTM Strategy', 'Demand Generation', 'Search Engine Optimization', 'Generative Engine Optimization', 'CRM Implementation', 'Sales Compensation', 'n8n', 'Zapier', 'Clay', 'Pipeline Analytics', 'Sales Forecasting'],
      sameAs: ['https://www.linkedin.com/company/homegrown-growth-co', 'https://www.linkedin.com/in/ianchamberland/'],
    },
    {
      '@type': 'FAQPage',
      mainEntity: faqs.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
  ],
};

const stats = [
  { value: '$150K+', label: 'Saved vs hiring a full-time VP, year one', svg: '<path d="M12 1v22M17 5H9.5a3.5 3.5 0 000 7h5a3.5 3.5 0 010 7H6"/>' },
  { value: '$30K+', label: 'Annual ad waste eliminated via real attribution', svg: '<path d="M22 11.08V12a10 10 0 11-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/>' },
  { value: '$50K+', label: 'Tech stack savings from a typical audit', svg: '<circle cx="20" cy="20" r="8" transform="translate(-8 -8)"/><path d="M12 12v3l2 2"/><path d="M19 16l5 5"/>' },
  { value: '10+ hrs', label: 'Reclaimed weekly after automation goes live', svg: '<circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/>' },
  { value: '2-4x', label: 'Forecast accuracy: gut feel to data-backed', svg: '<line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/>' },
  { value: '30-90', label: 'Days to first measurable ROI on average', svg: '<rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/>' },
];

const capabilities = [
  { title: 'GTM Strategy', href: '/gtm-strategy', desc: 'ICP, positioning, motion.', tag: 'Strategy', svg: '<circle cx="22" cy="22" r="14"/><circle cx="22" cy="22" r="8"/><circle cx="22" cy="22" r="2.5" fill="currentColor"/>' },
  { title: 'Fractional RevOps', href: '/fractional-revops', desc: 'Senior ownership of revenue ops.', tag: 'Strategy', svg: '<circle cx="22" cy="22" r="4"/><path d="M22 8v4M22 32v4M8 22h4M32 22h4M12.7 12.7l2.8 2.8M28.5 28.5l2.8 2.8M12.7 31.3l2.8-2.8M28.5 15.5l2.8-2.8"/>' },
  { title: 'Tech Stack Audit', href: '/tech-stack-audit', desc: 'What to keep, what to cut.', tag: 'Strategy', svg: '<circle cx="20" cy="20" r="10"/><path d="M28.5 28.5L36 36"/><path d="M20 15v5l3 3"/>' },
  { title: 'CRM Implementation', href: '/crm-implementation', desc: 'Salesforce or HubSpot, done right.', tag: 'Systems', svg: '<ellipse cx="22" cy="13" rx="12" ry="5"/><path d="M10 13v8c0 2.8 5.4 5 12 5s12-2.2 12-5v-8"/><path d="M10 21v8c0 2.8 5.4 5 12 5s12-2.2 12-5v-8"/>' },
  { title: 'Reporting & Analytics', href: '/reporting-analytics', desc: 'Dashboards that drive decisions.', tag: 'Systems', svg: '<rect x="8" y="8" width="28" height="20" rx="2"/><path d="M14 32h16M22 28v4"/><path d="M14 22l5-6 4 4 5-7 4 4" stroke-linecap="round" stroke-linejoin="round"/>' },
  { title: 'Workflows & Automation', href: '/process-automation', desc: 'Logic in systems, not heads.', tag: 'Systems', svg: '<rect x="8" y="8" width="10" height="10" rx="2"/><rect x="26" y="8" width="10" height="10" rx="2"/><rect x="17" y="26" width="10" height="10" rx="2"/><path d="M18 13h8M22 18v8"/>' },
  { title: 'Demand Generation', href: '/demand-generation', desc: 'Paid, organic, tied to revenue.', tag: 'Growth', svg: '<path d="M8 10h28l-8 16v8l-12 4v-12L8 10z"/>' },
  { title: 'Website SEO & GEO', href: '/website-seo-geo', desc: 'Visible on Google and on AI.', tag: 'Growth', svg: '<circle cx="20" cy="20" r="11"/><path d="M9 20h22M20 9c4 3.5 4 18 0 22M20 9c-4 3.5-4 18 0 22"/><path d="M28 28l8 8"/>' },
  { title: 'Sales Comp & Enablement', href: '/sales-comp-enablement', desc: 'Plans reps and finance trust.', tag: 'Growth', svg: '<circle cx="22" cy="22" r="14"/><path d="M22 13v2M22 29v2"/><path d="M18 17.5c0-1.9 1.8-3.5 4-3.5s4 1.6 4 3.5c0 2-2 3-4 3.5-2 .5-4 1.5-4 3.5 0 1.9 1.8 3.5 4 3.5s4-1.6 4-3.5"/>' },
];

const tools = [
  { name: 'HubSpot', logo: '/logos/hubspot.svg' },
  { name: 'Salesforce', logo: '/logos/salesforce.svg' },
  { name: 'Clay', logo: '/logos/clay.png' },
  { name: 'n8n', logo: '/logos/n8n.svg' },
  { name: 'Zapier', logo: '/logos/zapier.svg' },
  { name: 'Stripe', logo: '/logos/stripe.svg' },
  { name: 'Slack', logo: '/logos/slack.svg' },
  { name: 'Notion', logo: '/logos/notion.svg' },
];

const steps = [
  { num: '01', title: 'Diagnostic call', body: 'Free 30 minutes. We talk about where the money is leaking. You leave with at least one thing to act on either way.', svg: '<path d="M20 2v6M14 5l3 3 3-3M3 12a17 17 0 0017 17 3 3 0 003-3v-2.5a1.5 1.5 0 00-1.2-1.5l-3-.6a1.5 1.5 0 00-1.6.7l-1 1.7a13 13 0 01-6-6l1.7-1a1.5 1.5 0 00.7-1.6l-.6-3A1.5 1.5 0 008.5 12H6a3 3 0 00-3 3z"/>' },
  { num: '02', title: 'Scoped proposal', body: 'Inside the week. Engagement model that fits the work (retainer, project, outcome-based, or audit). No bloat.', svg: '<path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="8" y1="13" x2="16" y2="13"/><line x1="8" y1="17" x2="14" y2="17"/>' },
  { num: '03', title: 'Embedded execution', body: 'Weekly cadence, async access between syncs, work happens in your tools. Same week start, typically.', svg: '<circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 00.33 1.82l.06.06a2 2 0 010 2.83 2 2 0 01-2.83 0l-.06-.06a1.65 1.65 0 00-1.82-.33 1.65 1.65 0 00-1 1.51V21a2 2 0 01-2 2 2 2 0 01-2-2v-.09A1.65 1.65 0 009 19.4a1.65 1.65 0 00-1.82.33l-.06.06a2 2 0 01-2.83 0 2 2 0 010-2.83l.06-.06a1.65 1.65 0 00.33-1.82 1.65 1.65 0 00-1.51-1H3a2 2 0 01-2-2 2 2 0 012-2h.09A1.65 1.65 0 004.6 9a1.65 1.65 0 00-.33-1.82l-.06-.06a2 2 0 010-2.83 2 2 0 012.83 0l.06.06a1.65 1.65 0 001.82.33H9a1.65 1.65 0 001-1.51V3a2 2 0 012-2 2 2 0 012 2v.09a1.65 1.65 0 001 1.51 1.65 1.65 0 001.82-.33l.06-.06a2 2 0 012.83 0 2 2 0 010 2.83l-.06.06a1.65 1.65 0 00-.33 1.82V9a1.65 1.65 0 001.51 1H21a2 2 0 012 2 2 2 0 01-2 2h-.09a1.65 1.65 0 00-1.51 1z"/>' },
  { num: '04', title: 'Measurable ROI', body: 'Monthly review against agreed metrics. If the work is not paying off in dollars or hours saved, you hear about it first.', svg: '<line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/>' },
];
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  schema={schema}
>
  <main id="main" class="page-content">

    <section class="hero" aria-label="Hero">
      <div class="container">
        <div class="hero__inner hero__inner--split">
          <div class="hero__content">
            <div class="hero__pretag">Fractional Growth Operations</div>

            <h1 class="hero__headline fade-up">
              Senior growth ops,<br />fractional cost.
            </h1>

            <p class="hero__sub fade-up fade-up-delay-1">
              Your pipeline forecast is a gut call. Manual work owns the week. The founder is still routing leads and fixing CRM fields. Hire one senior growth ops partner instead of three.
            </p>

            <div class="btn-group fade-up fade-up-delay-2">
              <a href="/roi-call" class="btn btn--primary btn--lg">Book a free 30-min call</a>
              <a href="/services" class="btn btn--outline btn--lg">See what I do</a>
            </div>
          </div>
          <div class="hero__visual hero__visual--mesh fade-up fade-up-delay-1" aria-hidden="true">
            <svg class="hero__mesh" viewBox="0 0 500 400" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Fractional Growth Operations connecting the growth stack">
              <defs>
                <radialGradient id="hero-bg-grad" cx="50%" cy="50%" r="70%">
                  <stop offset="0%" stop-color="#FFFFFF"/>
                  <stop offset="60%" stop-color="#F4F8F7"/>
                  <stop offset="100%" stop-color="#E2EEEC"/>
                </radialGradient>
                <filter id="hero-node-shadow" x="-30%" y="-30%" width="160%" height="160%">
                  <feGaussianBlur in="SourceAlpha" stdDeviation="2.5"/>
                  <feOffset dx="0" dy="2"/>
                  <feComponentTransfer><feFuncA type="linear" slope="0.15"/></feComponentTransfer>
                  <feMerge><feMergeNode/><feMergeNode in="SourceGraphic"/></feMerge>
                </filter>
                <filter id="hero-hub-shadow" x="-40%" y="-40%" width="180%" height="180%">
                  <feGaussianBlur in="SourceAlpha" stdDeviation="8"/>
                  <feOffset dx="0" dy="6"/>
                  <feComponentTransfer><feFuncA type="linear" slope="0.28"/></feComponentTransfer>
                  <feMerge><feMergeNode/><feMergeNode in="SourceGraphic"/></feMerge>
                </filter>
                <pattern id="hero-dot-grid" width="22" height="22" patternUnits="userSpaceOnUse">
                  <circle cx="1.5" cy="1.5" r="1" fill="#49A69C" opacity="0.12"/>
                </pattern>
              </defs>

              <rect width="500" height="400" fill="url(#hero-bg-grad)"/>
              <rect width="500" height="400" fill="url(#hero-dot-grid)"/>

              <g stroke="#49A69C" stroke-width="1.5" stroke-dasharray="3 5" stroke-linecap="round" opacity="0.32" fill="none">
                <line x1="250" y1="200" x2="395" y2="200"/>
                <line x1="250" y1="200" x2="353" y2="303"/>
                <line x1="250" y1="200" x2="250" y2="345"/>
                <line x1="250" y1="200" x2="147" y2="303"/>
                <line x1="250" y1="200" x2="105" y2="200"/>
                <line x1="250" y1="200" x2="147" y2="97"/>
                <line x1="250" y1="200" x2="250" y2="55"/>
                <line x1="250" y1="200" x2="353" y2="97"/>
              </g>

              <g fill="none" stroke="#49A69C" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <g transform="translate(250 55)" filter="url(#hero-node-shadow)">
                  <circle r="36" fill="#FFFFFF" stroke="rgba(73,166,156,0.20)" stroke-width="1.2"/>
                  <g transform="translate(-14.5 -14.5) scale(0.66)">
                    <circle cx="22" cy="22" r="14"/>
                    <circle cx="22" cy="22" r="8"/>
                    <circle cx="22" cy="22" r="2.5" fill="#49A69C" stroke="none"/>
                  </g>
                </g>

                <g transform="translate(353 97)" filter="url(#hero-node-shadow)">
                  <circle r="36" fill="#FFFFFF" stroke="rgba(73,166,156,0.20)" stroke-width="1.2"/>
                  <g transform="translate(-14.5 -14.5) scale(0.66)">
                    <circle cx="20" cy="20" r="10"/>
                    <path d="M28.5 28.5L36 36"/>
                    <path d="M20 15v5l3 3"/>
                  </g>
                </g>

                <g transform="translate(395 200)" filter="url(#hero-node-shadow)">
                  <circle r="36" fill="#FFFFFF" stroke="rgba(73,166,156,0.20)" stroke-width="1.2"/>
                  <g transform="translate(-14.5 -14.5) scale(0.66)">
                    <ellipse cx="22" cy="13" rx="12" ry="5"/>
                    <path d="M10 13v8c0 2.8 5.4 5 12 5s12-2.2 12-5v-8"/>
                    <path d="M10 21v8c0 2.8 5.4 5 12 5s12-2.2 12-5v-8"/>
                  </g>
                </g>

                <g transform="translate(353 303)" filter="url(#hero-node-shadow)">
                  <circle r="36" fill="#FFFFFF" stroke="rgba(73,166,156,0.20)" stroke-width="1.2"/>
                  <g transform="translate(-14.5 -14.5) scale(0.66)">
                    <rect x="8" y="8" width="28" height="20" rx="2"/>
                    <path d="M14 32h16M22 28v4"/>
                    <path d="M14 22l5-6 4 4 5-7 4 4"/>
                  </g>
                </g>

                <g transform="translate(250 345)" filter="url(#hero-node-shadow)">
                  <circle r="36" fill="#FFFFFF" stroke="rgba(73,166,156,0.20)" stroke-width="1.2"/>
                  <g transform="translate(-14.5 -14.5) scale(0.66)">
                    <rect x="8" y="8" width="10" height="10" rx="2"/>
                    <rect x="26" y="8" width="10" height="10" rx="2"/>
                    <rect x="17" y="26" width="10" height="10" rx="2"/>
                    <path d="M18 13h8M22 18v8"/>
                  </g>
                </g>

                <g transform="translate(147 303)" filter="url(#hero-node-shadow)">
                  <circle r="36" fill="#FFFFFF" stroke="rgba(73,166,156,0.20)" stroke-width="1.2"/>
                  <g transform="translate(-14.5 -14.5) scale(0.66)">
                    <path d="M8 10h28l-8 16v8l-12 4v-12L8 10z"/>
                  </g>
                </g>

                <g transform="translate(105 200)" filter="url(#hero-node-shadow)">
                  <circle r="36" fill="#FFFFFF" stroke="rgba(73,166,156,0.20)" stroke-width="1.2"/>
                  <g transform="translate(-14.5 -14.5) scale(0.66)">
                    <circle cx="20" cy="20" r="11"/>
                    <path d="M9 20h22M20 9c4 3.5 4 18 0 22M20 9c-4 3.5-4 18 0 22"/>
                    <path d="M28 28l8 8"/>
                  </g>
                </g>

                <g transform="translate(147 97)" filter="url(#hero-node-shadow)">
                  <circle r="36" fill="#FFFFFF" stroke="rgba(73,166,156,0.20)" stroke-width="1.2"/>
                  <g transform="translate(-14.5 -14.5) scale(0.66)">
                    <circle cx="22" cy="22" r="14"/>
                    <path d="M22 13v2M22 29v2"/>
                    <path d="M18 17.5c0-1.9 1.8-3.5 4-3.5s4 1.6 4 3.5c0 2-2 3-4 3.5-2 .5-4 1.5-4 3.5 0 1.9 1.8 3.5 4 3.5s4-1.6 4-3.5"/>
                  </g>
                </g>
              </g>

              <g transform="translate(250 200)" filter="url(#hero-hub-shadow)">
                <circle r="58" fill="#49A69C"/>
                <circle r="58" fill="none" stroke="#FFFFFF" stroke-width="1.5" stroke-opacity="0.25"/>
                <g transform="translate(-22 -22)" stroke="#FFFFFF" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" fill="none">
                  <polyline points="6 32 16 22 22 28 38 12"/>
                  <polyline points="32 12 38 12 38 18"/>
                </g>
              </g>

              <text x="250" y="385" text-anchor="middle" font-family="'DM Mono', ui-monospace, monospace" font-size="9" letter-spacing="2.5" fill="#6B7280" opacity="0.7">FRACTIONAL · GROWTH · OPS</text>
            </svg>
          </div>
        </div>
      </div>
    </section>

    <section class="stat-strip-section" aria-label="Quick facts">
      <div class="container">
        <div class="stat-strip">
          {stats.map((s, i) => (
            <div class:list={['stat-strip__item', 'fade-up', `fade-up-delay-${i + 1}`]}>
              <div class="stat-strip__icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={s.svg}></svg>
              </div>
              <div class="stat-strip__value">{s.value}</div>
              <div class="stat-strip__label">{s.label}</div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="tools-strip" aria-label="Tools and platforms">
      <div class="container">
        <p class="tools-strip__label">Built on the stack you already use</p>
        <div class="tools-strip__logos">
          {tools.map((t) => (
            <div class="tool-logo">
              {t.logo ? (
                <img src={t.logo} alt={`${t.name} logo`} class="tool-logo__img" loading="lazy" />
              ) : (
                <span class="tool-logo__mark" aria-hidden="true"></span>
              )}
              <span class="tool-logo__name">{t.name}</span>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="section section--bg section--compact" aria-labelledby="services-heading">
      <div class="container">
        <div class="section-header section-header--compact fade-up">
          <span class="section-eyebrow">Capabilities</span>
          <h2 class="display-md section-title" id="services-heading">Nine ways to move the number.</h2>
        </div>

        <div class="capability-grid">
          {capabilities.map((s, i) => (
            <a href={s.href} class:list={['capability-card', 'fade-up', `fade-up-delay-${(i % 3) + 1}`]}>
              <div class="capability-card__icon" aria-hidden="true">
                <svg viewBox="0 0 44 44" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={s.svg}></svg>
              </div>
              <div class="capability-card__body">
                <span class="capability-card__tag">{s.tag}</span>
                <h3 class="capability-card__title">{s.title}</h3>
                <p class="capability-card__desc">{s.desc}</p>
              </div>
            </a>
          ))}
        </div>

        <div class="capability-grid__footer fade-up">
          <a href="/services" class="capability-grid__link">See full service detail
            <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
        </div>
      </div>
    </section>

    <section class="dark-section" aria-labelledby="how-heading">
      <div class="container">
        <div class="section-header fade-up">
          <span class="section-eyebrow section-eyebrow--light">How It Works</span>
          <h2 class="display-lg section-title title--on-dark" id="how-heading">Four steps. No theatre.</h2>
        </div>

        <div class="process-grid">
          {steps.map((s, i) => (
            <div class:list={['process-card', 'fade-up', `fade-up-delay-${i + 1}`]}>
              <div class="process-card__top">
                <span class="process-card__num">{s.num}</span>
                <div class="process-card__icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" set:html={s.svg}></svg>
                </div>
              </div>
              <h3 class="process-card__title">{s.title}</h3>
              <p class="process-card__body">{s.body}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="section section--surface section--compact" aria-labelledby="concerns-heading">
      <div class="container container--narrow">
        <div class="section-header section-header--compact fade-up">
          <span class="section-eyebrow">Questions</span>
          <h2 class="display-md section-title" id="concerns-heading">Common ones.</h2>
        </div>

        <div class="faq-stack">
          {faqs.map((f, i) => (
            <details class:list={['faq-item', 'fade-up', `fade-up-delay-${(i % 3) + 1}`]}>
              <summary class="faq-item__q">
                <span>{f.q}</span>
                <svg class="faq-item__chevron" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 6l5 5 5-5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </summary>
              <p class="faq-item__a">{f.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="cta-section" aria-label="Call to action">
      <div class="container container--narrow text-center">
        <div class="fade-up">
          <h2 class="display-lg section-title title--on-dark-spaced">Book a free 30-minute call.</h2>
          <p class="cta-body">A structured diagnostic. No pitch, no proposal on the call. You leave with at least one concrete thing to act on.</p>
          <a href="/roi-call" class="btn btn--white btn--lg">Book a free 30-min call</a>
        </div>
      </div>
    </section>

  </main>
</BaseLayout>
