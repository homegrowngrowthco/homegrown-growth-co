---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'Homegrown Growth Co. | Fractional Growth, SEO & Demand Partner';
const description = 'I help growing businesses get found, win more customers, and keep them coming back: SEO and AI search, demand gen, CRM, and automation from one senior partner.';
const canonical = 'https://homegrowngrowth.co/';

const faqs = [
  { q: 'Why this model instead of a full-time hire?', a: 'A senior growth ops leader runs $200K+ in base salary before benefits, plus a three-to-six month hiring runway. Most growing businesses get more value from one senior partner at 30% of that cost, with the option to scale up or step out cleanly. No severance, no recruiter fees, no learning curve.' },
  { q: "How do I know you'll understand my business?", a: "Every engagement starts with a structured diagnostic. Nothing gets built until there's a clear picture of your motion, your team, and where the actual friction is." },
  { q: 'Can you work with our existing team?', a: 'Yes. This is embedded work, not advisory. Everything happens inside your tools with weekly cadence and documentation, so the team is aligned and nothing lives in my head.' },
  { q: 'What if we only need help for a short period?', a: "Project-based engagements cover defined scopes: a CRM rebuild, a comp plan design, a demand gen audit, an SEO migration. Not everything needs to be ongoing." },
];

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'ProfessionalService',
      name: 'Homegrown Growth Co.',
      description: 'A fractional growth partner for growing businesses. Get found on Google and AI search, win more customers through demand generation and a CRM that works, and reclaim time with automation, all owned end-to-end by one senior partner. Serving local and multi-location operators (restaurants, home services, medical, auto) and B2B and SaaS teams alike.',
      url: 'https://homegrowngrowth.co',
      email: 'ian@homegrowngrowth.co',
      image: 'https://homegrowngrowth.co/og-image.png',
      logo: 'https://homegrowngrowth.co/apple-touch-icon.png',
      priceRange: '$$',
      founder: {
        '@type': 'Person',
        name: 'Ian Chamberland',
        jobTitle: 'Founder & Fractional Growth Partner',
        knowsAbout: ['Demand Generation', 'Search Engine Optimization', 'Generative Engine Optimization', 'Local SEO', 'Google Business Profile Optimization', 'Lead Generation', 'Revenue Operations', 'GTM Strategy', 'CRM Implementation', 'Salesforce', 'HubSpot', 'Sales Compensation', 'Process Automation', 'Workflow Automation'],
        hasCredential: ['HubSpot Revenue Operations Certified (2026)', '8+ years Revenue Operations experience, including Head of Global Revenue Operations'],
      },
      address: { '@type': 'PostalAddress', addressLocality: 'Massachusetts', addressRegion: 'MA', addressCountry: 'US' },
      areaServed: ['Massachusetts', 'New England', 'United States'],
      hasOfferCatalog: {
        '@type': 'OfferCatalog',
        name: 'Growth Operations Services',
        itemListElement: [
          { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'GTM Strategy' } },
          { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Fractional RevOps' } },
          { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Tech Stack Audit' } },
          { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'CRM Implementation & Cleanup' } },
          { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Reporting & Analytics' } },
          { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Workflows & Automation' } },
          { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Demand Generation' } },
          { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Website SEO & GEO' } },
          { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Conversion & Landing Pages' } },
          { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Retention & Expansion' } },
          { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Data Enrichment & Hygiene' } },
          { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Sales Comp & Enablement' } },
        ],
      },
      knowsAbout: ['Salesforce', 'HubSpot', 'Revenue Operations', 'GTM Strategy', 'Demand Generation', 'Search Engine Optimization', 'Generative Engine Optimization', 'CRM Implementation', 'Sales Compensation', 'n8n', 'Zapier', 'Clay', 'Pipeline Analytics', 'Sales Forecasting'],
      sameAs: [
        'https://www.linkedin.com/company/homegrown-growth-co',
        'https://www.linkedin.com/in/ianchamberland/',
        'https://share.google/pjlSd3uuV2CDQqxLD',
        'https://clutch.co/profile/homegrown-growth-co',
        'https://theautomationsguide.com',
      ],
    },
    {
      '@type': 'FAQPage',
      mainEntity: faqs.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
  ],
};

const stats = [
  { value: '$1M+', label: 'Pipeline added in year one from a rebuilt motion', svg: '<path d="M12 1v22M17 5H9.5a3.5 3.5 0 000 7h5a3.5 3.5 0 010 7H6"/>' },
  { value: '$30K+', label: 'Annual ad waste eliminated via real attribution', svg: '<path d="M22 11.08V12a10 10 0 11-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/>' },
  { value: '$50K+', label: 'Tech stack savings from a typical audit', svg: '<circle cx="20" cy="20" r="8" transform="translate(-8 -8)"/><path d="M12 12v3l2 2"/><path d="M19 16l5 5"/>' },
  { value: '10+ hrs', label: 'Reclaimed weekly after automation goes live', svg: '<circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/>' },
  { value: '2-4x', label: 'Forecast accuracy: gut feel to data-backed', svg: '<line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/>' },
  { value: '30-90', label: 'Days to first measurable ROI on average', svg: '<rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/>' },
];

const SVC = {
  gtm:      { title: 'GTM Strategy', href: '/gtm-strategy', desc: 'ICP, positioning, motion.', svg: '<circle cx="22" cy="22" r="14"/><circle cx="22" cy="22" r="8"/><circle cx="22" cy="22" r="2.5" fill="currentColor"/>' },
  revops:   { title: 'Fractional RevOps', href: '/fractional-revops', desc: 'Senior ownership of revenue ops.', svg: '<circle cx="22" cy="22" r="4"/><path d="M22 8v4M22 32v4M8 22h4M32 22h4M12.7 12.7l2.8 2.8M28.5 28.5l2.8 2.8M12.7 31.3l2.8-2.8M28.5 15.5l2.8-2.8"/>' },
  audit:    { title: 'Tech Stack Audit', href: '/tech-stack-audit', desc: 'What to keep, what to cut.', svg: '<circle cx="20" cy="20" r="10"/><path d="M28.5 28.5L36 36"/><path d="M20 15v5l3 3"/>' },
  crm:      { title: 'CRM Implementation', href: '/crm-implementation', desc: 'Salesforce or HubSpot, done right.', svg: '<ellipse cx="22" cy="13" rx="12" ry="5"/><path d="M10 13v8c0 2.8 5.4 5 12 5s12-2.2 12-5v-8"/><path d="M10 21v8c0 2.8 5.4 5 12 5s12-2.2 12-5v-8"/>' },
  reporting:{ title: 'Reporting & Analytics', href: '/reporting-analytics', desc: 'Dashboards that drive decisions.', svg: '<rect x="8" y="8" width="28" height="20" rx="2"/><path d="M14 32h16M22 28v4"/><path d="M14 22l5-6 4 4 5-7 4 4" stroke-linecap="round" stroke-linejoin="round"/>' },
  workflows:{ title: 'Workflows & Automation', href: '/process-automation', desc: 'Logic in systems, not heads.', svg: '<rect x="8" y="8" width="10" height="10" rx="2"/><rect x="26" y="8" width="10" height="10" rx="2"/><rect x="17" y="26" width="10" height="10" rx="2"/><path d="M18 13h8M22 18v8"/>' },
  demand:   { title: 'Demand Generation', href: '/demand-generation', desc: 'Paid, organic, tied to revenue.', svg: '<path d="M8 10h28l-8 16v8l-12 4v-12L8 10z"/>' },
  seo:      { title: 'Website SEO & GEO', href: '/website-seo-geo', desc: 'Visible on Google and on AI search.', svg: '<circle cx="20" cy="20" r="11"/><path d="M9 20h22M20 9c4 3.5 4 18 0 22M20 9c-4 3.5-4 18 0 22"/><path d="M28 28l8 8"/>' },
  salescomp:{ title: 'Sales Comp & Enablement', href: '/sales-comp-enablement', desc: 'Plans reps and finance trust.', svg: '<circle cx="22" cy="22" r="14"/><path d="M22 13v2M22 29v2"/><path d="M18 17.5c0-1.9 1.8-3.5 4-3.5s4 1.6 4 3.5c0 2-2 3-4 3.5-2 .5-4 1.5-4 3.5 0 1.9 1.8 3.5 4 3.5s4-1.6 4-3.5"/>' },
  conversion:{ title: 'Conversion & Landing Pages', href: '/conversion-landing-pages', desc: 'Turn visitors into customers and bookings.', svg: '<path d="M14 14l18 7-7.5 2.5L22 31z"/><path d="M24.5 24.5L33 33"/>' },
  retention:{ title: 'Retention & Expansion', href: '/retention-expansion', desc: 'Keep customers and grow their value.', svg: '<path d="M33 22a11 11 0 11-3.2-7.8"/><polyline points="30 7 30 15 22 15"/>' },
  enrichment:{ title: 'Data Enrichment & Hygiene', href: '/data-enrichment-hygiene', desc: 'Clean, deduped, compliant data, automatically.', svg: '<ellipse cx="22" cy="12" rx="12" ry="5"/><path d="M10 12v18c0 2.8 5.4 5 12 5s12-2.2 12-5V12"/><path d="M16 23l4 4 8-8"/>' },
};

const pillars = [
  { name: 'More customers', blurb: 'Get found, bring people in, and turn them into customers.', services: [SVC.seo, SVC.demand, SVC.conversion] },
  { name: 'More revenue', blurb: 'Work every lead and grow what you already have.', services: [SVC.crm, SVC.retention, SVC.reporting] },
  { name: 'More time back', blurb: 'Put the busywork on autopilot.', services: [SVC.workflows, SVC.enrichment, SVC.revops] },
];

const proofStats = [
  { value: '$1M+', label: 'Pipeline added, year one' },
  { value: '$30K+', label: 'Ad waste eliminated' },
  { value: '$50K+', label: 'Tech stack saved' },
  { value: '10+ hrs', label: 'Reclaimed weekly' },
  { value: '2-4x', label: 'Forecast accuracy' },
  { value: '30-90', label: 'Days to ROI' },
];

const verticals = [
  { name: 'Local & multi-location', desc: 'Restaurants, home services, medical and wellness, auto, and other local or multi-location businesses that need to get found and booked.', href: '/for-local-businesses', cta: 'Local businesses' },
  { name: 'B2B & SaaS', desc: 'Software and B2B teams that need senior RevOps, GTM, and demand-gen firepower without a full-time hire.', href: '/for-saas', cta: 'B2B & SaaS' },
];

const tools = [
  { name: 'HubSpot', logo: '/logos/hubspot.svg' },
  { name: 'Salesforce', logo: '/logos/salesforce.svg' },
  { name: 'Clay', logo: '/logos/clay.png' },
  { name: 'n8n', logo: '/logos/n8n.svg' },
  { name: 'Zapier', logo: '/logos/zapier.svg' },
  { name: 'Stripe', logo: '/logos/stripe.svg' },
  { name: 'Slack', logo: '/logos/slack.svg' },
  { name: 'Notion', logo: '/logos/notion.svg' },
  { name: 'Your stack', logo: '/logos/custom-stack.svg' },
];

const steps = [
  { num: '01', title: 'Free ROI call', body: 'Free 30 minutes. We talk about where the money is leaking. You leave with at least one thing to act on either way.', svg: '<path d="M20 2v6M14 5l3 3 3-3M3 12a17 17 0 0017 17 3 3 0 003-3v-2.5a1.5 1.5 0 00-1.2-1.5l-3-.6a1.5 1.5 0 00-1.6.7l-1 1.7a13 13 0 01-6-6l1.7-1a1.5 1.5 0 00.7-1.6l-.6-3A1.5 1.5 0 008.5 12H6a3 3 0 00-3 3z"/>' },
  { num: '02', title: 'Scoped proposal', body: 'Inside the week. Engagement model that fits the work (retainer, project, outcome-based, or audit). No bloat.', svg: '<path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="8" y1="13" x2="16" y2="13"/><line x1="8" y1="17" x2="14" y2="17"/>' },
  { num: '03', title: 'Embedded execution', body: 'Weekly cadence, async access between syncs, work happens in your tools. Same week start, typically.', svg: '<circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 00.33 1.82l.06.06a2 2 0 010 2.83 2 2 0 01-2.83 0l-.06-.06a1.65 1.65 0 00-1.82-.33 1.65 1.65 0 00-1 1.51V21a2 2 0 01-2 2 2 2 0 01-2-2v-.09A1.65 1.65 0 009 19.4a1.65 1.65 0 00-1.82.33l-.06.06a2 2 0 01-2.83 0 2 2 0 010-2.83l.06-.06a1.65 1.65 0 00.33-1.82 1.65 1.65 0 00-1.51-1H3a2 2 0 01-2-2 2 2 0 012-2h.09A1.65 1.65 0 004.6 9a1.65 1.65 0 00-.33-1.82l-.06-.06a2 2 0 010-2.83 2 2 0 012.83 0l.06.06a1.65 1.65 0 001.82.33H9a1.65 1.65 0 001-1.51V3a2 2 0 012-2 2 2 0 012 2v.09a1.65 1.65 0 001 1.51 1.65 1.65 0 001.82-.33l.06-.06a2 2 0 012.83 0 2 2 0 010 2.83l-.06.06a1.65 1.65 0 00-.33 1.82V9a1.65 1.65 0 001.51 1H21a2 2 0 012 2 2 2 0 01-2 2h-.09a1.65 1.65 0 00-1.51 1z"/>' },
  { num: '04', title: 'Measurable ROI', body: 'Monthly review against agreed metrics. If the work is not paying off in dollars or hours saved, you hear about it first.', svg: '<line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/>' },
];
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  schema={schema}
>
  <main id="main" class="page-content">

    <section class="hero" aria-label="Hero">
      <div class="container">
        <div class="hero__inner hero__inner--split">
          <div class="hero__content">
            <h1 class="hero__headline fade-up">
              Get found. <span class="hero__headline-accent">Win customers.</span> Keep them coming back.
            </h1>

            <p class="hero__sub fade-up fade-up-delay-1">
              I'm a fractional growth partner for businesses that have outgrown doing it themselves. From getting found on Google and AI search to the demand gen, CRM, and automation behind the scenes, I own the work end-to-end, and prove it pays for itself.
            </p>

            <div class="btn-group fade-up fade-up-delay-2">
              <a href="/roi-call" class="btn btn--primary btn--lg">Book a free ROI call</a>
              <a href="#free-audit" class="btn btn--outline btn--lg">Get a free audit</a>
            </div>
          </div>

          <aside class="hero__proof fade-up fade-up-delay-1" aria-label="Outcomes by the numbers">
            <p class="hero__proof-eyebrow">By the numbers</p>
            <ul class="hero__proof-grid">
              {proofStats.map((s) => (
                <li>
                  <span class="hero__proof-value">{s.value}</span>
                  <span class="hero__proof-label">{s.label}</span>
                </li>
              ))}
            </ul>
            <p class="hero__proof-foot">Representative outcomes from recent engagements.</p>
          </aside>
        </div>
      </div>
    </section>

    <section class="tools-strip" aria-label="Platforms I work in">
      <div class="container">
        <p class="tools-strip__label">The platforms I work in</p>
        <div class="tools-strip__logos">
          {tools.map((t) => (
            <div class="tool-logo">
              {t.logo ? (
                <img src={t.logo} alt={`${t.name} logo`} class="tool-logo__img" loading="lazy" />
              ) : (
                <span class="tool-logo__mark" aria-hidden="true"></span>
              )}
              <span class="tool-logo__name">{t.name}</span>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="section section--bg section--compact" aria-labelledby="services-heading">
      <div class="container">
        <div class="section-header section-header--compact fade-up">
          <span class="section-eyebrow">Capabilities</span>
          <h2 class="display-md section-title" id="services-heading">Three outcomes. Twelve ways to get there.</h2>
        </div>

        <div class="pillars">
          {pillars.map((p, i) => (
            <div class:list={['pillar', 'fade-up', `fade-up-delay-${i + 1}`]}>
              <div class="pillar__head">
                <h3 class="pillar__name">{p.name}</h3>
                <p class="pillar__blurb">{p.blurb}</p>
              </div>
              <div class="pillar__list">
                {p.services.map((s) => (
                  <a href={s.href} class="pillar__svc">
                    <span class="pillar__svc-icon" aria-hidden="true">
                      <svg viewBox="0 0 44 44" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={s.svg}></svg>
                    </span>
                    <span class="pillar__svc-body">
                      <span class="pillar__svc-title">{s.title}</span>
                      <span class="pillar__svc-desc">{s.desc}</span>
                    </span>
                    <svg class="pillar__svc-arrow" width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  </a>
                ))}
              </div>
            </div>
          ))}
        </div>

        <div class="capability-grid__footer fade-up">
          <a href="/services" class="capability-grid__link">See all twelve services
            <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
        </div>
      </div>
    </section>

    <section class="section section--surface section--compact" aria-labelledby="who-heading">
      <div class="container">
        <div class="section-header section-header--compact fade-up">
          <span class="section-eyebrow">Who I help</span>
          <h2 class="display-md section-title" id="who-heading">Built for growing businesses, not just one kind.</h2>
        </div>

        <div class="verticals">
          {verticals.map((v, i) => (
            <a href={v.href} class:list={['vertical-card', 'fade-up', `fade-up-delay-${i + 1}`]}>
              <h3 class="vertical-card__name">{v.name}</h3>
              <p class="vertical-card__desc">{v.desc}</p>
              <span class="vertical-card__cta">{v.cta}
                <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="section section--bg section--compact" aria-labelledby="operator-heading">
      <div class="container">
        <div class="operator">
          <div class="operator__photo fade-up">
            <img src="/images/ian-headshot.jpg" alt="Ian Chamberland, founder of Homegrown Growth Co." width="320" height="380" loading="lazy" />
          </div>
          <div class="operator__body fade-up fade-up-delay-1">
            <span class="section-eyebrow">The operator</span>
            <h2 class="display-md section-title" id="operator-heading">You work with me, not a junior team.</h2>
            <p class="operator__lead">I'm Ian Chamberland. I've spent 8+ years in growth and revenue operations, most recently as Head of Global Revenue Operations, before going independent to do this work hands-on for growing businesses. When you hire Homegrown Growth Co., I'm the one in your tools every week, not a salesperson who hands you off. I work across your marketing, sales, and service, and drive the adoption so the systems actually get used.</p>
            <div class="operator__badges">
              <span class="operator__badge">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6L9 17l-5-5"/></svg>
                HubSpot Revenue Operations Certified
              </span>
              <span class="operator__badge">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6L9 17l-5-5"/></svg>
                8+ years, ex-Head of Global RevOps
              </span>
            </div>
            <a href="/about" class="capability-grid__link">More about how I work
              <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </a>
          </div>
        </div>
      </div>
    </section>

    <section class="dark-section" aria-labelledby="how-heading">
      <div class="container">
        <div class="section-header fade-up">
          <span class="section-eyebrow section-eyebrow--light">How It Works</span>
          <h2 class="display-lg section-title title--on-dark" id="how-heading">Four steps. No theatre.</h2>
        </div>

        <div class="process-grid">
          {steps.map((s, i) => (
            <div class:list={['process-card', 'fade-up', `fade-up-delay-${i + 1}`]}>
              <div class="process-card__top">
                <span class="process-card__num">{s.num}</span>
                <div class="process-card__icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" set:html={s.svg}></svg>
                </div>
              </div>
              <h3 class="process-card__title">{s.title}</h3>
              <p class="process-card__body">{s.body}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="section section--surface section--compact" aria-labelledby="concerns-heading">
      <div class="container">
        <div class="section-header section-header--compact fade-up">
          <span class="section-eyebrow">Questions</span>
          <h2 class="display-md section-title" id="concerns-heading">Common questions from new clients.</h2>
        </div>

        <div class="faq-stack">
          {faqs.map((f, i) => (
            <details class:list={['faq-item', 'fade-up', `fade-up-delay-${(i % 3) + 1}`]}>
              <summary class="faq-item__q">
                <span>{f.q}</span>
                <svg class="faq-item__chevron" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 6l5 5 5-5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </summary>
              <p class="faq-item__a">{f.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section id="free-audit" class="section section--surface section--compact" aria-labelledby="audit-heading">
      <div class="container">
        <div class="audit">
          <div class="audit__copy fade-up">
            <span class="section-eyebrow">Free audit</span>
            <h2 class="display-md section-title" id="audit-heading">Not ready for a call? Get a free growth audit.</h2>
            <p class="audit__lead">Send your website and I'll send back a short, no-strings review: where you're losing customers, what's hurting your visibility on Google and AI search, and the two or three highest-leverage fixes. No pitch attached.</p>
            <ul class="audit__points">
              <li>Where your site and SEO are leaking customers</li>
              <li>How you show up on Google and in AI answers</li>
              <li>The highest-leverage fixes, prioritized</li>
            </ul>
          </div>
          <form name="free-audit" method="POST" data-netlify="true" netlify-honeypot="bot-field" class="audit__form fade-up fade-up-delay-1">
            <input type="hidden" name="form-name" value="free-audit" />
            <p class="audit__hp" hidden><label>Don't fill this out: <input name="bot-field" /></label></p>
            <div class="form-field">
              <label for="audit-name">Name</label>
              <input id="audit-name" type="text" name="name" autocomplete="name" placeholder="Your name" required />
            </div>
            <div class="form-field">
              <label for="audit-email">Email</label>
              <input id="audit-email" type="email" name="email" autocomplete="email" placeholder="you@company.com" required />
            </div>
            <div class="form-field">
              <label for="audit-url">Website URL</label>
              <input id="audit-url" type="url" name="website" placeholder="https://" required />
            </div>
            <p class="audit__error" role="alert" hidden>
              Something went wrong submitting the form. Please try again, or email
              <a href="mailto:ian@homegrowngrowth.co">ian@homegrowngrowth.co</a>.
            </p>
            <button type="submit" class="btn btn--primary btn--lg audit__submit">Send my free audit</button>
            <p class="audit__fineprint">I'll reply within two business days. No spam, no list.</p>
          </form>
          <div class="audit__form audit__success" hidden role="status" aria-live="polite">
            <h3 class="audit__success-title">Got it. Your audit is on the way.</h3>
            <p class="audit__success-body">I'll review your site and send the audit to your inbox within two business days. Want to talk it through sooner?</p>
            <a href="/roi-call" class="btn btn--primary btn--lg audit__success-cta">Book a free ROI call</a>
          </div>
        </div>
      </div>
    </section>

    <section class="cta-section" aria-label="Call to action">
      <div class="container text-center">
        <div class="fade-up">
          <h2 class="display-lg section-title title--on-dark-spaced">Book a free ROI call.</h2>
          <p class="cta-body">Thirty minutes to map current process and discuss potential ideas and improvements. No pitch, no proposal on the call. You leave with concrete next steps to grow your business, regardless of fit.</p>
          <a href="/roi-call" class="btn btn--white btn--lg">Book a free ROI call</a>
        </div>
      </div>
    </section>

  </main>
</BaseLayout>

<script>
  (() => {
    const form = document.querySelector<HTMLFormElement>('form[name="free-audit"]:not([hidden])');
    if (!form) return;
    const successEl = document.querySelector<HTMLElement>('.audit__success');
    const errorEl = form.querySelector<HTMLElement>('.audit__error');
    const submitBtn = form.querySelector<HTMLButtonElement>('.audit__submit');
    if (!successEl || !errorEl || !submitBtn) return;

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      errorEl.hidden = true;

      if (!form.checkValidity()) {
        form.reportValidity();
        return;
      }

      submitBtn.disabled = true;
      submitBtn.textContent = 'Sending…';

      const body = new URLSearchParams(new FormData(form) as unknown as Record<string, string>).toString();

      fetch('/', {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
        body,
      })
        .then((res) => {
          if (!res.ok) throw new Error('HTTP ' + res.status);
          form.hidden = true;
          successEl.hidden = false;
          successEl.scrollIntoView({ behavior: 'smooth', block: 'center' });
          // Conversion tracking: GA4 key event + Clarity custom event (best-effort).
          const w = window as unknown as { gtag?: (...a: unknown[]) => void; clarity?: (...a: unknown[]) => void };
          w.gtag?.('event', 'generate_lead', { form_name: 'free-audit' });
          w.clarity?.('event', 'free_audit_submit');
        })
        .catch(() => {
          errorEl.hidden = false;
          submitBtn.disabled = false;
          submitBtn.textContent = 'Send my free audit';
        });
    });
  })();
</script>
