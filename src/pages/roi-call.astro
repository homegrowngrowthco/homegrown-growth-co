---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'Book Your Free ROI Call | Homegrown Growth Co.';
const description = 'Find out exactly where your growth operations are leaking. No pitch, no proposal. A structured conversation with an honest assessment.';
const canonical = 'https://homegrowngrowth.co/roi-call';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://homegrowngrowth.co/' },
    { '@type': 'ListItem', position: 2, name: 'Book Your Free ROI Call', item: canonical },
  ],
};
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  schema={schema}
  bareNav={true}
  bareFooter={true}
>
  <!-- Calendly assets, page-specific, loaded inline -->
  <link rel="stylesheet" href="https://assets.calendly.com/assets/external/widget.css" />
  <script src="https://assets.calendly.com/assets/external/widget.js" type="text/javascript" async is:inline></script>

  <!-- Simplified nav, logo only -->
  <header class="roi-nav" role="banner">
    <a href="/" class="nav__logo" aria-label="HGC Homegrown Growth Co. home">
      <span class="logo-mark" style="font-size:1.5rem;"><span class="hg" style="color:var(--color-dark);">HG</span><span class="c" style="color:var(--color-teal);">C</span></span>
      <span class="logo-name" style="color:var(--color-dark);">Homegrown Growth Co.</span>
    </a>
  </header>

  <main id="main">

    <section class="roi-page" aria-label="Book your free ROI call">
      <div class="container">

        <div class="roi-layout">

          <div class="roi-left">
            <div class="roi-left__tag fade-up">
              <svg width="6" height="6" viewBox="0 0 6 6" aria-hidden="true"><circle cx="3" cy="3" r="3" fill="currentColor"/></svg>
              Free ROI Call
            </div>

            <h1 class="roi-left__headline fade-up fade-up-delay-1">
              Find out where revenue is leaking, and the upside if it's rebuilt.
            </h1>

            <p class="roi-left__body fade-up fade-up-delay-2">
              This isn't a sales call. It's thirty structured minutes to diagnose where your operations are costing you, what's possible if they're rebuilt, and whether there's a fit to work together. You leave with one concrete thing you can act on, regardless of how the conversation ends.
            </p>

            <div class="roi-left__covers fade-up fade-up-delay-3" aria-label="What we'll cover">
              <p class="roi-left__covers-title">What we'll cover</p>
              <div class="roi-left__cover-item">
                <span class="roi-left__cover-dot" aria-hidden="true"></span>
                <span>Where strategy, systems, or acquisition gaps are creating revenue leakage</span>
              </div>
              <div class="roi-left__cover-item">
                <span class="roi-left__cover-dot" aria-hidden="true"></span>
                <span>Whether your CRM, reporting, and systems are set up to support how you actually grow</span>
              </div>
              <div class="roi-left__cover-item">
                <span class="roi-left__cover-dot" aria-hidden="true"></span>
                <span>What working together would look like for your specific situation</span>
              </div>
              <div class="roi-left__cover-item">
                <span class="roi-left__cover-dot" aria-hidden="true"></span>
                <span>Honest assessment of whether it makes sense to work together</span>
              </div>
            </div>

            <div class="roi-left__note fade-up fade-up-delay-4">
              <strong>No pressure, no proposal on the call.</strong> If there's a fit, a clear scope follows. If not, you'll hear that directly.
            </div>
          </div>

          <div class="fade-up fade-up-delay-2">
            <div class="calendly-wrapper" aria-label="Schedule a call">
              <div
                id="calendly-embed"
                class="calendly-inline-widget"
                data-url="https://calendly.com/homegrown-growth-co/homegrown-growth-ian"
                style="min-width:280px; height:660px;"
              ></div>
            </div>
          </div>

        </div>

        <div class="roi-trust fade-up">
          <div class="roi-trust__grid">

            <div class="roi-trust__item">
              <div class="roi-trust__icon" aria-hidden="true">
                <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="10" cy="7" r="3"/>
                  <path d="M3 17c0-3.3 3.1-6 7-6s7 2.7 7 6"/>
                </svg>
              </div>
              <p class="roi-trust__text">Solo operator. You'll always talk to me, not a coordinator</p>
            </div>

            <div class="roi-trust__item">
              <div class="roi-trust__icon" aria-hidden="true">
                <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="2" y="5" width="16" height="12" rx="2"/>
                  <path d="M7 5V4a3 3 0 016 0v1"/>
                  <path d="M10 10v3M8.5 11.5l1.5-1.5 1.5 1.5"/>
                </svg>
              </div>
              <p class="roi-trust__text">No retainer required to start. Project work available.</p>
            </div>

            <div class="roi-trust__item">
              <div class="roi-trust__icon" aria-hidden="true">
                <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="2" y="2" width="7" height="7" rx="1.5"/>
                  <rect x="11" y="2" width="7" height="7" rx="1.5"/>
                  <rect x="2" y="11" width="7" height="7" rx="1.5"/>
                  <rect x="11" y="11" width="7" height="7" rx="1.5"/>
                </svg>
              </div>
              <p class="roi-trust__text">Salesforce, HubSpot, n8n, Zapier, Clay, plus demand gen and SEO. One partner instead of multiple specialists.</p>
            </div>

          </div>
        </div>

      </div>
    </section>

  </main>

  <footer class="roi-footer" role="contentinfo">
    <div class="container">
      <a href="/" class="roi-footer__back">← Back to home</a>
      <span style="margin-left: 18px; font-size: 0.875rem; color: var(--color-muted);">
        <a href="/privacy-policy" style="color: inherit; text-decoration: none;">Privacy</a>
        <span aria-hidden="true" style="margin: 0 8px;">·</span>
        <a href="/terms" style="color: inherit; text-decoration: none;">Terms</a>
      </span>
    </div>
  </footer>
</BaseLayout>
