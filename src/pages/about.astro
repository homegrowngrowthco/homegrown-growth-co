---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';

const title = 'About | Homegrown Growth Co.';
const description = 'Ian, founder of Homegrown Growth Co. 8+ years in growth and revenue operations, from data analyst to Head of Global Revenue Operations. A fractional growth partner for growing companies and local service businesses. Based in Massachusetts.';
const canonical = 'https://homegrowngrowth.co/about';

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      name: 'Ian Chamberland',
      jobTitle: 'Founder & Fractional Growth Partner',
      description: '8 years of revenue operations experience, from data analyst to Head of Global Revenue Operations. Founder of Homegrown Growth Co.',
      url: canonical,
      worksFor: {
        '@type': 'Organization',
        name: 'Homegrown Growth Co.',
        url: 'https://homegrowngrowth.co',
      },
      address: {
        '@type': 'PostalAddress',
        addressLocality: 'Massachusetts',
        addressRegion: 'MA',
        addressCountry: 'US',
      },
      sameAs: [
        'https://www.linkedin.com/in/ianchamberland/',
        'https://www.linkedin.com/company/homegrown-growth-co',
      ],
      knowsAbout: [
        'Revenue Operations',
        'GTM Strategy',
        'Demand Generation',
        'Search Engine Optimization',
        'Generative Engine Optimization',
        'Local SEO',
        'Google Business Profile Optimization',
        'Lead Generation',
        'Multi-Location Operations',
        'CRM Implementation',
        'Salesforce',
        'HubSpot',
        'Sales Compensation',
        'Process Automation',
        'Workflow Automation',
        'Pipeline Analytics',
        'Sales Forecasting',
      ],
      memberOf: {
        '@type': 'Organization',
        name: 'Salute to Soldiers Foundation',
        description: "Nonprofit supporting America's Vet Dogs",
        url: 'https://sites.google.com/view/asalutetosoldiers/home',
      },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://homegrowngrowth.co/' },
        { '@type': 'ListItem', position: 2, name: 'About', item: canonical },
      ],
    },
  ],
};
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  ogType="profile"
  schema={schema}
>
  <main id="main" class="page-content">

    <PageHero
      tag="About"
      headline="Built for businesses that need senior ops thinking. Not another layer of overhead."
      headlineMaxWidth="820px"
    />

    <section class="section section--surface" aria-label="About Ian">
      <div class="container">
        <div class="about-bio">

          <div class="about-bio__text fade-up">
            <p>I'm Ian, founder of Homegrown Growth Co. My career has been spent inside high-growth companies building the systems, processes, and reporting infrastructure that make revenue predictable. From building RevOps functions from scratch to managing global operations teams, the work has helped teams drive 2-4x growth in key revenue and pipeline metrics by taking an analytical approach to the GTM engine.</p>
            <p>HGC was founded because the same pattern kept repeating: growing businesses stuck with overpriced agencies, junior admins, or no senior growth ops support at all. You don't need another deck or SOP. You need real ROI that drives your business forward.</p>
            <p>The work here is direct engagement with founders, owners, executives, and GTM leaders who want a senior-level thought partner who will also build the thing and show the ROI to prove it's working. Stop guessing, start measuring.</p>
            <p>Lately, a lot of that work is helping local and multi-location service businesses (home services, medical and wellness, auto, restaurants) get found and booked. I score a business's digital presence (Google Business Profile, reviews, website, and whether AI search can even surface it), then fix what is quietly leaking leads.</p>
            <p><a href="/roi-call" class="link-teal about-bio__cta">Get a free visibility audit &rarr;</a></p>
            <p>Based in Massachusetts.</p>
            <p>Outside of client work, I serve as Treasurer on the board of the <a href="https://sites.google.com/view/asalutetosoldiers/home" target="_blank" rel="noopener" class="link-teal">Salute to Soldiers Foundation</a>, a nonprofit supporting America's Vet Dogs. Financial stewardship, accountability, and building systems that actually work. The same principles that drive good growth operations show up there too.</p>
            <a href="https://www.linkedin.com/in/ianchamberland/" class="about-bio__linkedin" target="_blank" rel="noopener" aria-label="Connect on LinkedIn">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
              Connect on LinkedIn
            </a>
          </div>

          <div class="about-bio__photo about-bio__photo--real fade-up fade-up-delay-2">
            <img src="/images/ian-headshot.jpg" alt="Ian Chamberland, founder of Homegrown Growth Co." width="320" height="380" loading="lazy" />
          </div>

        </div>

        <div class="skills-section fade-up">
          <p class="skills-title">Tools & Expertise</p>
          <div class="skills-pills" role="list" aria-label="Skills and tools">
            <span class="skill-pill" role="listitem">Salesforce</span>
            <span class="skill-pill" role="listitem">HubSpot</span>
            <span class="skill-pill" role="listitem">n8n</span>
            <span class="skill-pill" role="listitem">Zapier</span>
            <span class="skill-pill" role="listitem">Clay</span>
            <span class="skill-pill" role="listitem">Excel / Sheets</span>
            <span class="skill-pill" role="listitem">SQL</span>
            <span class="skill-pill" role="listitem">Forecasting</span>
            <span class="skill-pill" role="listitem">Sales Comp</span>
            <span class="skill-pill" role="listitem">Pipeline Analytics</span>
            <span class="skill-pill" role="listitem">CRM Migration</span>
            <span class="skill-pill" role="listitem">GTM Strategy</span>
            <span class="skill-pill" role="listitem">Demand Gen</span>
            <span class="skill-pill" role="listitem">SEO &amp; GEO</span>
            <span class="skill-pill" role="listitem">Attribution</span>
          </div>
        </div>

        <div class="community-section fade-up">
          <p class="skills-title">Community</p>
          <div class="community-card">
            <div class="community-card__icon" aria-hidden="true">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.84 4.61a5.5 5.5 0 00-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 00-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 000-7.78z"/></svg>
            </div>
            <div>
              <p class="community-card__role">Board Member · Treasurer</p>
              <p class="community-card__org">Salute to Soldiers Foundation. Supporting America's Vet Dogs.</p>
              <p class="community-card__desc">Serving on the board of the Salute to Soldiers Foundation, a nonprofit dedicated to supporting America's Vet Dogs and the veterans they serve. As Treasurer, I oversee financial stewardship and help build the operational structure that keeps the mission moving forward.</p>
              <a href="https://sites.google.com/view/asalutetosoldiers/home" target="_blank" rel="noopener" class="community-card__link">
                Learn about the Foundation
                <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true"><path d="M2.5 9.5l7-7M5 2.5h4.5V7" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </a>
            </div>
          </div>
        </div>

      </div>
    </section>

    <section class="section section--bg" aria-labelledby="why-heading">
      <div class="container container--narrow">
        <div class="fade-up">
          <span class="section-eyebrow">Why This Model</span>
          <h2 class="display-md section-title" id="why-heading" class="mb-20">The model exists because the alternative doesn't work.</h2>
          <p class="legal-prose mb-20">A senior growth ops hire (VP of RevOps, Head of GTM, Director of Growth Operations) costs $150-200K+ base, takes months to hire, and is overkill for most growing businesses. A junior admin executes tasks but doesn't own strategy. Agencies charge for decks and hand off to junior staff.</p>
          <p class="legal-prose">This model exists for teams that want the senior thinking and the actual execution, without the overhead of a full-time hire. That's what HGC was built to be.</p>
        </div>
      </div>
    </section>

    <section class="cta-section" aria-label="Call to action">
      <div class="container container--narrow text-center">
        <div class="fade-up">
          <h2 class="display-lg section-title title--on-dark-spaced">Not sure where to start?<br />Book a free ROI call.</h2>
          <p class="cta-body">No pitch, no proposal. An honest conversation about where revenue is leaking, what's possible if it's rebuilt, and what would actually move the needle.</p>
          <a href="/roi-call" class="btn btn--white btn--lg">Book Your Free ROI Call</a>
        </div>
      </div>
    </section>

  </main>
</BaseLayout>
